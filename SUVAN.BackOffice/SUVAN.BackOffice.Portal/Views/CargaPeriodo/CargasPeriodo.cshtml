@using SUVAN.BackOffice.Models.ViewModel.Enums;
@using SUVAN.BackOffice.Portal.Helper;
@inject IUsuarioHelper UsuarioHelper

@{
    ViewData["Title"] = "Cargas del Periodo";
}

@{
    var permisosPagina = await UsuarioHelper.GetPermisosPagina(User, EnumOpcionMenu.empresas);
    if (permisosPagina == null)
    {
        return;
    }
}
<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar ">
    <!--begin::Toolbar container-->
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
        <!--begin::Toolbar wrapper-->
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <!--begin::Page title-->
            <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                <!--begin::Title-->
                <h1 class="page-heading d-flex flex-column justify-content-center text-dark fw-bold fs-3 m-0">@ViewData["Title"]</h1>
                <!--end::Title-->
            </div>
            <!--end::Page title-->
        </div>
        <!--end::Toolbar wrapper-->
    </div>
    <!--end::Toolbar container-->
</div>
<!--end::Toolbar-->

<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <!--begin::Content container-->
    <div id="kt_app_content_container" class="app-container container-fluid">
        <!--begin::Card-->
        <div class="card">
            <!--begin::Card header-->
            <div class="card-header border-0 pt-6">
                <!--begin::Card title-->
                <div class="card-title">
                    <!--begin::Search-->
                    <div class="d-flex align-items-center position-relative my-1">
                        <i class="ki-outline ki-magnifier fs-3 position-absolute ms-5"></i>
                        <input type="text" id="txtBuscarGrid" class="form-control form-control-solid w-450px ps-13" placeholder="Buscar..." disabled />
                    </div>
                    <!--end::Search-->
                </div>
                <!--begin::Card title-->
            </div>
            <!--end::Card header-->

            <!--begin::Filtros en Cascada-->
            <div class="row w-100 m-0 px-6 pb-4">
                <div class="col-md-3">
                    <label class="form-label fw-bold text-dark fs-7">Region: </label>
                    <select id="cmbRegion" class="form-select form-select-solid fs-7">
                        <option value="">Seleccione una Región</option>
                        @if (ViewBag.Regiones !=null)
                        {
                            foreach (var reg in ViewBag.Regiones)
                            {
                                <option value="@reg.Id">@reg.Nombre</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold text-dark fs-7">Planta: </label>
                    <select id="cmbPlanta" class="form-select form-select-solid fs-7" disabled>
                        <option value="">Seleccione una Planta...</option>
                        </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold text-dark fs-7">Zona: </label>
                    <select id="cmbZona" class="form-select form-select-solid fs-7" disabled>
                        <option value="">Seleccione una Zona...</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold text-dark fs-7">Deposito: </label>
                    <select id="cmbDeposito" class="form-select form-select-solid fs-7" disabled>
                        <option value="">Seleccione un Deposito...</option>
                    </select>
                </div>
            </div>
            <!--end::Filtros en Cascada-->

            <!--begin::Table-->
            <div class="card-body py-4">
                <div class="table-responsive">
                    <table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_table_cargas_periodo">
                        <thead>
                            <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">                                
                                <th class="min-w-85px">Núm Económico</th>
                                <th class="min-w-80px">Marca</th>
                                <th class="min-w-80px">Modelo</th>
                                <th class="min-w-80px">Placas</th>
                                <th class="min-w-85px">Fecha</th>
                                <th class="text-end min-w-90px">Km. Anterior</th>
                                <th class="text-end min-w-90px">Km. Actual</th>
                                <th class="text-end min-w-80px">Km. Recorridos</th>
                                <th class="text-center min-w-80px">Folio Nota</th>
                                <th class="text-end min-w-80px">Litros</th>
                                <th class="text-end min-w-70px">Costo por Lt.</th>
                                <th class="text-end min-w-90px">Importe</th>
                                <th class="text-end min-w-70px">Rendimiento</th>
                                <th class="min-w-100px">Combustible</th>
                                <!--<th class="min-w-70px">Espec</th>-->
                                <!--<th class="min-w-70px">Factura</th>-->
                                
                            </tr>
                        </thead>
                        <tbody id="tbodyCargas" class="text-gray-600 fw-semibold">
                            <tr>
                                <td colspan="14" class="text-center text-muted py-10">Seleccione un depósito para consultar las cargas por periodo. </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <!--end::Table-->

                <!--begin::Panel estadisticas (inferior)-->
                <!--<div class="card bg-light-primary mt-6 p-5 border border-primary border-opacity-25">
                    <h5 class="text-dark fw-bold mb-4"><i class="ki-outline ki-chart-pie-3 fs-3 me-2"></i>Estadísticas del periodo</h5>-->
                <div class="card panel-estadisticas-guinda mt-6 p-5">
                    <h5 class="fw-bold mb-4"><i class="ki-outline ki-chart-pie-3 fs-3 me-2"></i>Estadísticas del periodo</h5>

                    <div class="row text-gray-800 fw-semibold fs-6">
                        <div class="col-md-3 mb-2">
                            <span class="text-muted d-block fs-7">Cargas Totales: 
                                <!--boton detalle-->
                                <button type="button" class="btn btn-icon btn-active-ligth-primary btn-sm ms-2 p-0 w-20px h-20px" id="btnVerVehiculosCargas" title="Ver vehiculos con carga">
                                    <i class="ki-outline ki-eye fs-4 text-primary"></i>
                                </button>
                            </span>
                            <span id="lblCargasTotales" class="fw-bold fs-5">0</span>
                        </div>
                        <div class="col-md-3 mb-2">
                            <span class="text-muted d-block fs-7">Consumo Litros:</span>
                            <span id="lblConsumoLitros" class="fw-bold fs-5">0.00</span>
                        </div>
                        <div class="col-md-3 mb-2">
                            <span class="text-muted d-block fs-7">Importe Total:</span>
                            <span id="lblImporteTotal" class="fw-bold fs-5">$0.00</span>
                        </div>
                        <div class="col-md-3 mb-2">
                            <span class="text-muted d-block fs-7">Kms Recorridos Totales:</span>
                            <span id="lblKmsTotales" class="fw-bold fs-5">0.00</span>
                        </div>
                        <div class="col-md-3 mb-2">
                            <span class="text-muted d-block fs-7">Kms. por Litro:</span>
                            <span id="lblKmPorLitro" class="fw-bold fs-5">0.00</span>
                        </div>
                        <div class="col-md-3 mb-2">
                            <span class="text-muted d-block fs-7">Costo x Km Recorrido:</span>
                            <span id="lblCostoPorKm" class="fw-bold fs-5">$0.00</span>
                        </div>
                    </div>
                </div>
                <!--end::Panel estadisticas-->

                <!--begin::Modal  de Vehiculos con cargas-->
                <div class="modal fade" id="kt_modal_vehiculos_cargas" tabindex="-1" aria-hidden="true">
                    <!--begin::Modal dialog-->
                    <div class="modal-dialog modal-dialog-centered modal-lg">
                        <!--begin::Modal content-->
                        <div class="modal-content shadow-sm">
                            <!--begin::Modal header-->
                            <div class="modal-header border-bottom py-4 px-7">
                                <h3 class="fw-bold text-dark m-0">Vehículos con Cargas en el periodo</h3>
                                <!--begin::Close-->
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <!--end::Modal header-->


                            <!--begin::Modal body-->
                            <div class="modal-body scroll-y px-7 py-7">
                                <!--begin::Table-->
                                <div class="table-responsive">
                                    <table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_table_vehiculos_cargas">
                                        <thead>
                                            <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0 border-bottom">
                                                <th class="min-w-85px">Núm Económico</th>
                                                <th class="min-w-80px">Marca</th>
                                                <th class="min-w-80px">Modelo</th>
                                                <th class="min-w-80px">Placas</th>
                                            </tr>
                                        </thead>
                                        <tbody class="text-gray-600 fw-semibold" id="tbodyVehiculosCargas">
                                            <!--llenado dinamico desde JS-->
                                        </tbody>
                                    </table>
                                </div>
                                <!--end::Table-->
                            </div>
                            <!--end::Modal body-->

                            <!--begin::Modal footer-->
                            <div class="modal-footer border-top py-4 px-7">
                                <button type="button" class="btn btn-outline-secondary btn-active-light-primary px-6" data-bs-dismiss="modal">Cerrar</button>
                            </div>
                        </div>
                        <!--end::Modal content-->
                    </div>
                    <!--end::Modal dialog-->
                </div>
                <!--end::Modal  de Vehiculos con cargas-->

            </div>
            <!--end::Card body-->
        </div>
        <!--end::Card-->
    </div>
    <!--end::Content container-->
</div>
<!--end::Content-->
@section scripts {

    <script src="~/js/administrativo/CargasPeriodo/table.js" asp-append-version="true"></script>
    
}