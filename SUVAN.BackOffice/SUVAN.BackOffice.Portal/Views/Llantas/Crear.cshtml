@model SUVAN.BackOffice.Models.ViewModel.Administrativo.LlantaCrearViewModel

@{
    var esEdicion = Model.IdLlanta > 0;
    var formAction = esEdicion ? "Editar" : "Crear";
    var routeId = esEdicion ? Model.IdLlanta.ToString() : null;
    ViewData["Title"] = esEdicion ? "Editar llanta" : "Agregar llanta";
}

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                <h1 class="page-heading d-flex flex-column justify-content-center text-dark fw-bold fs-3 m-0">@ViewData["Title"]</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                    <li class="breadcrumb-item text-muted">
                        <a asp-controller="Llantas" asp-action="Index" class="text-muted text-hover-primary">Llantas</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span class="bullet bg-gray-400 w-5px h-2px"></span>
                    </li>
                    <li class="breadcrumb-item text-muted">@ViewData["Title"]</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!--end::Toolbar-->

<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">
        <form id="kt_form_llanta" asp-controller="Llantas" asp-action="@formAction" asp-route-id="@routeId" method="post" class="form">
            @Html.AntiForgeryToken()
            <input asp-for="IdLlanta" type="hidden" />

            <div class="card">
                <div class="card-body py-6">
                    @if (ViewData.ModelState.TryGetValue(string.Empty, out var modelOnlyState) && modelOnlyState.Errors.Count > 0)
                    {
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    }

                    <div class="mb-10">
                        <h3 class="fw-bold text-dark fs-5 mb-6">Ubicación inicial</h3>
                        <div class="row g-6">                           
                            <div class="col-md-4">
                                <label asp-for="IdRegion" class="required form-label">Región</label>
                                <select asp-for="IdRegion" id="IdRegion" class="form-select form-select-solid" data-control="select2" data-placeholder="Selecciona una región">
                                    <option value="">Selecciona una región</option>
                                    @foreach (var region in Model.Regiones)
                                    {
                                        <option value="@region.Id">@region.Nombre</option>
                                    }
                                </select>
                                <span asp-validation-for="IdRegion" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="IdPlanta" class="required form-label">Planta</label>
                                <select asp-for="IdPlanta" id="IdPlanta" class="form-select form-select-solid" data-control="select2" data-placeholder="Selecciona una planta" disabled="@(Model.IdRegion <= 0)">
                                    <option value="">Selecciona una planta</option>
                                    @foreach (var planta in Model.Plantas)
                                    {
                                        <option value="@planta.Id">@planta.Nombre</option>
                                    }
                                </select>
                                <span asp-validation-for="IdPlanta" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="IdZona" class="required form-label">Zona</label>
                                <select asp-for="IdZona" id="IdZona" class="form-select form-select-solid" data-control="select2" data-placeholder="Selecciona una zona" disabled="@(Model.IdPlanta <= 0)">
                                    <option value="">Selecciona una zona</option>
                                    @foreach (var zona in Model.Zonas)
                                    {
                                        <option value="@zona.Id">@zona.Nombre</option>
                                    }
                                </select>
                                <span asp-validation-for="IdZona" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="IdDeposito" class="required form-label">Depósito</label>
                                <select asp-for="IdDeposito" id="IdDeposito" class="form-select form-select-solid" data-control="select2" data-placeholder="Selecciona un depósito" disabled="@(Model.IdZona <= 0)">
                                    <option value="">Selecciona un depósito</option>
                                    @foreach (var deposito in Model.Depositos)
                                    {
                                        <option value="@deposito.Id">@deposito.Nombre</option>
                                    }
                                </select>
                                <span asp-validation-for="IdDeposito" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="separator separator-dashed my-8"></div>

                    <div class="mb-10">
                        <h3 class="fw-bold text-dark fs-5 mb-6">Identificación</h3>
                        <div class="row g-6">
                            <div class="col-md-4">
                                <label asp-for="CodigoLlanta" class="required form-label">Código de llanta</label>
                                <input asp-for="CodigoLlanta" class="form-control form-control-solid" maxlength="30" autocomplete="off" />
                                <span asp-validation-for="CodigoLlanta" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="NumeroSerieDot" class="required form-label">Número de serie / DOT</label>
                                <input asp-for="NumeroSerieDot" class="form-control form-control-solid" maxlength="30" autocomplete="off" />
                                <span asp-validation-for="NumeroSerieDot" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="IdMarcaLlanta" class="required form-label">Marca</label>
                                <select asp-for="IdMarcaLlanta" id="IdMarcaLlanta" class="form-select form-select-solid" data-control="select2" data-placeholder="Seleccione una marca">
                                    <option value="">Seleccione una marca</option>
                                    @foreach (var marca in Model.Marcas)
                                    {
                                        <option value="@marca.Id">@marca.Nombre</option>
                                    }
                                </select>
                                <span asp-validation-for="IdMarcaLlanta" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="IdModeloLlanta" class="required form-label">Modelo</label>
                                <select asp-for="IdModeloLlanta" id="IdModeloLlanta" class="form-select form-select-solid" data-control="select2" data-placeholder="Seleccione un modelo" disabled="@(Model.IdMarcaLlanta <= 0)">
                                    <option value="">Seleccione un modelo</option>
                                    @foreach (var modelo in Model.Modelos)
                                    {
                                        <option value="@modelo.Id">@modelo.Nombre</option>
                                    }
                                </select>
                                <span asp-validation-for="IdModeloLlanta" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="IdEstadoLlanta" class="required form-label">Estado de la llanta</label>
                                <select asp-for="IdEstadoLlanta" id="IdEstadoLlanta" class="form-select form-select-solid" data-control="select2" data-placeholder="Seleccione un estado">
                                    <option value="">Seleccione un estado</option>
                                    @foreach (var estado in Model.EstadosLlanta)
                                    {
                                        <option value="@estado.Id">@($"{estado.Id} - {estado.Nombre}")</option>
                                    }
                                </select>
                                <span asp-validation-for="IdEstadoLlanta" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="FechaFabricacion" class="form-label">Fecha de fabricación</label>
                                <input asp-for="FechaFabricacion" type="date" class="form-control form-control-solid" />
                                <span asp-validation-for="FechaFabricacion" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="separator separator-dashed my-8"></div>

                    <div>
                        <h3 class="fw-bold text-dark fs-5 mb-6">Adquisición</h3>
                        <div class="row g-6">
                            <div class="col-md-4">
                                <label asp-for="CostoAdquisicion" class="required form-label">Costo de adquisición</label>
                                <input asp-for="CostoAdquisicion" type="number" min="0" step="0.01" class="form-control form-control-solid" />
                                <span asp-validation-for="CostoAdquisicion" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="FechaAdquisicion" class="required form-label">Fecha de adquisición</label>
                                <input asp-for="FechaAdquisicion" type="date" class="form-control form-control-solid" />
                                <span asp-validation-for="FechaAdquisicion" class="text-danger"></span>
                            </div>
                            <div class="col-md-12">
                                <label asp-for="Observaciones" class="form-label">Observaciones</label>
                                <textarea asp-for="Observaciones" class="form-control form-control-solid" rows="4" maxlength="500"></textarea>
                                <span asp-validation-for="Observaciones" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="separator separator-dashed my-8"></div>

                    <div id="modeloDetalleContainer" class="mb-10 @(Model.ModeloDetalle == null ? "d-none" : string.Empty)">
                        <h3 class="fw-bold text-dark fs-5 mb-6">Información del modelo</h3>
                        <div class="row g-6">
                            <div class="col-md-4">
                                <label class="form-label">Marca</label>
                                <input id="ModeloDetalleMarca" type="text" class="form-control form-control-solid" value="@Model.ModeloDetalle?.Marca" readonly />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Modelo</label>
                                <input id="ModeloDetalleNombre" type="text" class="form-control form-control-solid" value="@Model.ModeloDetalle?.Modelo" readonly />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Medida</label>
                                <input id="ModeloDetalleMedida" type="text" class="form-control form-control-solid" value="@Model.ModeloDetalle?.Medida" readonly />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Presión mínima PSI</label>
                                <input id="ModeloDetallePresionMinima" type="text" class="form-control form-control-solid" value="@Model.ModeloDetalle?.PresionMinimaPsi?.ToString("0.##")" readonly />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Presión máxima PSI</label>
                                <input id="ModeloDetallePresionMaxima" type="text" class="form-control form-control-solid" value="@Model.ModeloDetalle?.PresionMaximaPsi?.ToString("0.##")" readonly />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Profundidad original mm</label>
                                <input id="ModeloDetalleProfundidad" type="text" class="form-control form-control-solid" value="@Model.ModeloDetalle?.ProfundidadOriginalMm?.ToString("0.##")" readonly />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Vida útil estimada km</label>
                                <input id="ModeloDetalleVidaUtil" type="text" class="form-control form-control-solid" value="@Model.ModeloDetalle?.VidaUtilEstimadaKm" readonly />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-end gap-3">
                    <a asp-controller="Llantas" asp-action="Index" class="btn btn-light">Cancelar</a>
                    <button type="submit" id="kt_llanta_submit" class="btn btn-primary">
                        <span class="indicator-label">@(esEdicion ? "Actualizar" : "Guardar")</span>
                        <span class="indicator-progress">
                            @(esEdicion ? "Actualizando..." : "Guardando...")
                            <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                        </span>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
<!--end::Content-->

@section Scripts {
    <script>
        window.SUVAN = window.SUVAN || {};
        window.SUVAN.Llantas = {
            getPlantasUrl: '@Url.Action("GetPlantasPorRegion", "Administrativo")',
            getZonasUrl: '@Url.Action("GetZonasPorPlanta", "Administrativo")',
            getDepositosUrl: '@Url.Action("GetDepositosPorZona", "Administrativo")',
            getModelosPorMarcaUrl: '@Url.Action("GetModelosPorMarca", "Llantas")',
            getDetalleModeloUrl: '@Url.Action("GetDetalleModelo", "Llantas")'
        };
    </script>
    <script src="~/js/administrativo/llantas/add.js" asp-append-version="true"></script>
    <script src="~/assets/js/widgets.bundle.js"></script>
    <script src="~/assets/js/custom/widgets.js"></script>
}
