@using SUVAN.BackOffice.Models.ViewModel;
@using SUVAN.BackOffice.Models.ViewModel.Enums;
@using SUVAN.BackOffice.Portal.Helper;
@inject IUsuarioHelper UsuarioHelper
@{
  ViewData["Title"] = "Usuarios";
}

@model AgregarUsuarioViewModel
@{
  var permisosPagina = await UsuarioHelper.GetPermisosPagina(User, EnumOpcionMenu.usuarios);
  if (permisosPagina == null)
  {
    return;
  }
  var isAgaregarText = Model.AdminId == 0 ? "Agregar" : "Editar";
}
<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar ">
  <!--begin::Toolbar container-->
  <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
    <!--begin::Toolbar wrapper-->
    <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
      <!--begin::Page title-->
      <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
        <!--begin::Title-->
        <a href="~/usuarios" class="page-heading d-flex justify-content-center align-center text-dark fw-bold fs-3 m-0 ">
          <i class="ki-duotone ki-left fs-1 pe-5">
          </i>
          <span>@isAgaregarText Usuario</span>
        </a>
        <!--end::Title-->

      </div>
      <!--end::Page title-->

    </div>
    <!--end::Toolbar wrapper-->
  </div>
  <!--end::Toolbar container-->
</div>
<!--end::Toolbar-->
<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
  <!--begin::Content container-->
  <div id="kt_app_content_container" class="app-container container-fluid">
    <!--begin::Card-->
    <div class="card">

      <!--begin::Card body-->
      <div class="card-body py-4">


        <form class="form w-100" novalidate="novalidate" id="kt_user_in_form" data-kt-redirect-url="/" asp-controller="Usuarios" asp-action="Agregar" method="post">
          <input asp-for="AdminId" type="hidden" />
          <input asp-for="EmpresasUsuario" type="hidden" />
                    <input asp-for="JerarquiasUsuario" type="hidden" />

          <div class="row">
            <div class="col-lg-6">
              <div class="fv-row mb-8">
                <div class="col-sm-12">
                  <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                    <div asp-validation-summary="All"></div>
                  </div>
                </div>
              </div>
              <div class="fv-row mb-8">
                <label asp-for="Nombre" class="col-sm-12 col-form-label text-gray-600 required">Nombre de usuario</label>
                <div class="col-sm-12">
                  <input asp-for="Nombre" class="form-control bg-transparent" placeholder="Nombre del usuario" maxlength="45" />
                  <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                    <span asp-validation-for="Nombre"></span>
                  </div>

                </div>
              </div>

              <div class="fv-row mb-8">
                <label asp-for="Email" class="col-sm-12 col-form-label text-gray-600 required">Correo electrónico</label>
                <div class="col-sm-12">
                  <input asp-for="Email" class="form-control bg-transparent" type="email" placeholder="Correo electrónico" />
                  <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                    <span asp-validation-for="Email"></span>
                  </div>

                </div>
              </div>

              @*     <div class="fv-row mb-8">
              <label asp-for="Password" class="col-sm-2 col-form-label text-gray-600">Contraseña *</label>
              <div class="col-sm-6">
              <input asp-for="Password" class="form-control bg-transparent" type="password" placeholder="Contraseña" />
              <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
              <span asp-validation-for="Password"></span>
              </div>

              </div>
              </div> *@
              @*      <div class="fv-row mb-8">
              <label asp-for="PerfilId" class="col-sm-12 col-form-label text-gray-600 required">Perfil de usuario</label>
              <div class="col-sm-12">
              <select asp-for="PerfilId" asp-items="new SelectList(Model.Perfiles, nameof(PerfilViewModel.PerfilId), nameof(PerfilViewModel.Nombre), Model.PerfilId)" class="form-control">
              <option value="">Selecciona un perfil</option>
              </select>
              <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
              <span asp-validation-for="PerfilId"></span>
              </div>

              </div>
              </div> *@

              <div class="fv-row mb-8">
                <div class="col-sm-4">
                  <div class="form-check">
                    <label asp-for="Activo" class="form-check-label"></label>
                    <input asp-for="Activo" class="form-check-input" />
                  </div>
                </div>
              </div>

                            <!--begin::Asignación de Jerarquía Organizacional-->
                            <div class="border rounded p-4 mb-8 bg-light-secondary">
                                <h4 class="text-gray-800 mb-4 fw-bold">Asignación Jerárquica Organizacional</h4>

                                <!--Región-->
                                <div class="fv-row mb-4">
                                    <label asp-for="IdRegion" class="col-form-label text-gray-600">Región</label>
                                    <select id="selectIdRegion" asp-for="IdRegion" class="form-select bg-white">
                                        <option value="">-- Seleccione una Región --</option>
                                        @foreach (var r in Model.Regiones)
                                        {
                                            <option value="@r.Id" selected="@(r.Id == Model.IdRegion ? "selected" : null)">@r.Nombre</option>
                                        }
                                    </select>
                                </div>

                                <!--Planta-->
                                <div class="fv-row mb-4">
                                    <label asp-for="IdPlanta" class="col-form-label text-gray-600">Planta</label>
                                    <select id="selectIdPlanta" asp-for="IdPlanta" class="form-select bg-white" disabled="@(!Model.IdRegion.HasValue)">
                                        <option value="">--(Primero seleccione una Región)--</option>
                                        @foreach (var p in Model.Plantas)
                                        {
                                            <option value="@p.Id" selected="@(p.Id == Model.IdPlanta ? "selected" : null)">@p.Nombre</option>
                                        }
                                    </select>
                                </div>

                                <!--Zona-->
                                <div class="fv-row mb-4">
                                    <label asp-for="IdZona" class="col-form-label text-gray-600">Zona</label>
                                    <select id="selectIdZona" asp-for="IdZona" class="form-select bg-white" disabled="@(!Model.IdPlanta.HasValue)">
                                        <option value="">--(Primero seleccione una Planta)--</option>
                                        @foreach (var z in Model.Zonas)
                                        {
                                            <option value="@z.Id" selected="@(z.Id == Model.IdZona ? "selected" : null)">@z.Nombre</option>
                                        }
                                    </select>
                                </div>

                                <!--Depósito-->
                                <div class="fv-row mb-4">
                                    <label asp-for="IdDeposito" class="col-form-label text-gray-600">Depósito</label>
                                    <select id="selectIdDeposito" asp-for="IdDeposito" class="form-select bg-white" disabled="@(!Model.IdZona.HasValue)">
                                        <option value="">--(Primero seleccione una Zona)--</option>
                                        @foreach (var d in Model.Depositos)
                                        {
                                            <option value="@d.Id" selected="@(d.Id == Model.IdDeposito ? "selected" : null)">@d.Nombre</option>
                                        }
                                    </select>
                                </div>

                                <!--Departamento-->
                                <div class="fv-row mb-4">
                                    <label asp-for="IdDepto" class="col-form-label text-gray-600">Departamento</label>
                                    <select id="selectIdDepto" asp-for="IdDepto" class="form-select bg-white" disabled="@(!Model.IdDeposito.HasValue)">
                                        <option value="">--(Primero seleccione un Depósito)--</option>
                                        @foreach (var dep in Model.Departamentos)
                                        {
                                            <option value="@dep.Id" selected="@(dep.Id == Model.IdDepto ? "selected" : null)">@dep.Nombre</option>
                                        }
                                    </select>
                                </div>

                                <!--Botón para agregar asignación de depósito a la lista de jerarquías-->
                                <div class="text-end mb-4">
                                    <button type="button" id="btn-agregar-jerarquia" class="btn btn-sm btn-light-primary fw-bold">
                                        <i class="ki-duotone ki-plus-circle fs-4 me-1"><span class="path1"></span><span class="path2"></span></i>
                                        Agregar Depósito a Jerarquía
                                    </button>
                                </div>

                                <!--Lista de depósitos/jerarquías asignadas-->
                                <div class="mt-4">
                                    <h6 class="text-gray-700 fw-bold mb-2">Depósitos / Jerarquías Asignadas</h6>
                                    <div id="jerarquiasContainer"></div>
                                </div>
                            </div>
                            <!--end::Asignación de Jerarquía Organizacional-->
            </div>
            <div class="col-lg-6">
              <div class="fv-row mb-8">
                <div class="col-md-12">
                  <h4 class="required">Asignación de empresa</h4>
                  <div class="row">
                    <div class="col-md-5">
                      <div class="fv-row mb-8">
                        <label asp-for="EmpresaId" class="col-sm-12 col-form-label text-gray-600 ">Empresa</label>
                        <div class="col-sm-12">
                          <select asp-for="EmpresaId" asp-items="new SelectList(Model.Empresas, nameof(EmpresaViewModel.EmpresaId), nameof(EmpresaViewModel.Nombre), Model.EmpresaId)" class="form-control">
                            <option value="">Selecciona una empresa</option>
                          </select>
                          <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                            <span asp-validation-for="EmpresaId"></span>
                          </div>

                        </div>
                      </div>
                    </div>
                    <div class="col-md-5">
                      <div class="fv-row mb-8">
                        <label asp-for="PerfilId" class="col-sm-12 col-form-label text-gray-600 ">Perfil</label>
                        <div class="col-sm-12">
                          <select asp-for="PerfilId" asp-items="new SelectList(Model.Perfiles, nameof(PerfilViewModel.PerfilId), nameof(PerfilViewModel.Nombre), Model.PerfilId)" class="form-control">
                            <option value="">Selecciona un perfil</option>
                          </select>
                          <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                            <span asp-validation-for="PerfilId"></span>
                          </div>

                        </div>
                      </div>
                    </div>


                    <div class="col-md-2">
                      <button type="button" id="agregar-empresa" class="btn btn-flex btn-color-gray-700 btn-active-color-primary bg-body h-40px fs-7 fw-bold">
                        <i class="ki-duotone ki-plus-circle mx-1">
                          <span class="path1"></span>
                          <span class="path2"></span>
                        </i>  Agregar
                      </button>
                    </div>
                  </div>
                  <div class="row">
                    <div class="col-md-12">
                      <div id="empresasContainer"></div>
                    </div>
                  </div>
                </div>
              </div>

            </div>
          </div>
          <div class="mb-10 text-end">

            <button type="submit" id="kt_user_in_submit" class="btn btn-primary">
              <!--begin::Indicator label-->
              <span class="indicator-label">Guardar</span>
              <!--end::Indicator label-->
              <!--begin::Indicator progress-->
              <span class="indicator-progress">
                Por favor espere...
                <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
              </span>
              <!--end::Indicator progress-->
            </button>
          </div>
        </form>


      </div>
      <!--end::Card body-->
    </div>
    <!--end::Card-->
  </div>
  <!--end::Content container-->
</div>
<!--end::Content-->
@section scripts {

  <script src="~/js/seguridad/usuarios/add.js" asp-append-version="true"></script>
  <script src="~/assets/js/widgets.bundle.js"></script>
  <script src="~/assets/js/custom/widgets.js"></script>

}