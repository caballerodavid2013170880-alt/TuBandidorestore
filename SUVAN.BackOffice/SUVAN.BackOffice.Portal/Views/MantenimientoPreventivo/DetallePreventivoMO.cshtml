@using SUVAN.BackOffice.Models.ViewModel.Logistica;
@model List<DetPrevMoItemViewModel>

@{
    ViewData["Title"] = "Detalle Vehículos (MO)";
}

<div id="kt_app_toolbar" class="app-toolbar">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                <a href="~/MantenimientoPreventivo/DetalleGeneral/@ViewBag.IdPreventivo" class="page-heading d-flex justify-content-center align-center text-dark fw-bold fs-3 m-0">
                    <i class="ki-duotone ki-left fs-1 pe-5"></i>
                    <span>Volver a Resumen General</span>
                </a>
            </div>
        </div>
    </div>
</div>

<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">
        <div class="card">
            <div class="card-header border-0 pt-6">
                <div class="card-title">
                    <div class="d-flex align-items-center position-relative my-1">
                        <i class="ki-outline ki-magnifier fs-3 position-absolute ms-5"></i>
                        <input type="text" data-kt-mo-table-filter="search" class="form-control form-control-solid w-350px ps-13" placeholder="Buscar en desglose..." />
                    </div>
                </div>
            </div>
            <div class="card-body py-4">
                <table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_table_detalle_mo">
                    <thead>
                        <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                            <th class="min-w-150px">Plan Preventivo</th>
                            <th class="min-w-150px">Mano de Obra</th>
                            <th class="min-w-100px">IVA Unitario</th>
                            <th class="min-w-150px">Costo Total Unit.</th>
                            <th class="min-w-150px">Fecha Preventivo</th>
                        </tr>
                    </thead>
                    <tbody class="text-gray-600 fw-semibold">
                        @foreach (var mo in Model)
                        {
                            <tr>
                                <td>@mo.NombrePreventivo</td>
                                <td>@mo.ManoObra</td>
                                <td>@((mo.Iva ?? 0).ToString("C"))</td>
                                <td>@mo.CostoTotalUnitario.ToString("C")</td>
                                <td>@mo.FechaPrev.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/js/logistica/preventivo/detallePreventivoMO.js" asp-append-version="true"></script>
}