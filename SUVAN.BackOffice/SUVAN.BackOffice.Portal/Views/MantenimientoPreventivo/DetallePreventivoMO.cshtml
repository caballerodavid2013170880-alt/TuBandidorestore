@using SUVAN.BackOffice.Models.ViewModel.Logistica
@model List<DetPrevMoItemViewModel>
@{
    ViewData["Title"] = "Detalle de Vehículos Coincidentes";
    int idPreventivo = ViewBag.IdPreventivo;
}

<div class="app-toolbar" id="kt_app_toolbar">
    <div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">
                @ViewData["Title"]
            </h1>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3">
            <a href="~/MantenimientoPreventivo/DetalleGeneral/@idPreventivo" class="btn btn-sm btn-light-primary">Volver al Resumen</a>
        </div>
    </div>
</div>

<div class="app-content flex-column-fluid" id="kt_app_content">
    <div class="app-container container-fluid">
        <div class="card card-flush">
            <div class="card-header pt-8">
                <div class="card-title">
                    <div class="d-flex align-items-center position-relative my-1">
                        <i class="ki-outline ki-magnifier fs-3 position-absolute ms-5"></i>
                        <input type="text" data-kt-vehiculos-filter="search" class="form-control form-control-solid w-250px ps-13" placeholder="Buscar vehículo..." />
                    </div>
                </div>
            </div>
            <div class="card-body pt-0">
                <table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_table_det_prev_mo">
                    <thead>
                        <tr class="text-start text-gray-400 fw-bold fs-7 text-uppercase gs-0">
                            <th>Plan Preventivo</th>
                            <th>Servicio (Mano de Obra)</th>
                            <th>Vehículo (Placas/VIN)</th>
                            <th>Costo Total (Unitario)</th>
                            <th>Fecha Prevista</th>
                        </tr>
                    </thead>
                    <tbody class="fw-semibold text-gray-600">
                        @foreach (var mo in Model)
                        {
                            <tr>
                                <td>@mo.NombrePreventivo</td>
                                <td>
                                  <span class="text-dark fw-bold">@mo.ManoObra</span>
                                    @if (mo.Actividades != null && mo.Actividades.Any())
                                    {
                                        <ul class="text-muted fs-8 mt-2 ps-4 mb-0">
                                            @foreach (var act in mo.Actividades)
                                            {
                                                <li>@act</li>
                                            }
                                        </ul>
                                    }
                                </td>
                                <td>
                                <td>
                                    <span class="text-dark fw-bold">@mo.Placas</span> <br />
                                    <span class="text-muted fs-7">VIN: @mo.Vin</span>
                                </td>
                                <td><span class="badge badge-light-info">@mo.CostoTotalUnitario.ToString("C")</span></td>
                                <td>@mo.FechaPrev.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section scripts {
    <script src="~/js/administrativo/preventivo/det_vehiculos.js" asp-append-version="true"></script>
}