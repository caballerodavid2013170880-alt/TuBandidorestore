@using SUVAN.BackOffice.Models.ViewModel.Enums;
@using SUVAN.BackOffice.Portal.Helper;
@inject IUsuarioHelper UsuarioHelper
@{
    ViewData["Title"] = "Mantenimiento Preventivo";
}
@model List<SUVAN.BackOffice.Database.Entities.Preventivo>
@{
    var permisosPagina = await UsuarioHelper.GetPermisosPagina(User, EnumOpcionMenu.MantenimientoPreventivo);
    if (permisosPagina == null) { return; }
}
<div id="kt_app_toolbar" class="app-toolbar ">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                <h1 class="page-heading d-flex flex-column justify-content-center text-dark fw-bold fs-3 m-0">@ViewData["Title"]</h1>
            </div>
            <div class="d-flex align-items-center gap-2 gap-lg-3">
                @if (permisosPagina!.Agregar)
                {
                    <a href="~/MantenimientoPreventivo/AgregarPreventivo" class="btn btn-flex btn-outline btn-color-gray-700 btn-active-color-primary bg-body h-40px fs-7 fw-bold">Agregar Preventivo</a>
                }
            </div>
        </div>
    </div>
</div>

<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">
        <div class="card">
            <div class="card-header border-0 pt-6">
                <div class="card-title">
                    <div class="d-flex align-items-center position-relative my-1">
                        <i class="ki-outline ki-magnifier fs-3 position-absolute ms-5"></i>
                        <input type="text" data-kt-preventivo-table-filter="search" class="form-control form-control-solid w-450px ps-13" placeholder="Buscar preventivo..." />
                    </div>
                </div>
            </div>
            <div class="card-body py-4">
                <input type="hidden" id="mensajeTempData" value="@TempData["Mensaje"]" />
                <table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_table_preventivo">
                    <thead>
                        <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                            <th class="min-w-200px">Nombre</th>
                            <th class="min-w-150px">Planta / Depósito</th>
                            <th class="min-w-150px">Marca / Modelo</th>
                            <th class="min-w-150px">Fecha de creación </th>
                            <th class="text-end min-w-100px">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="text-gray-600 fw-semibold">
                        @foreach (var prev in Model)
                        {
                            <tr>
                                <td>@prev.NombrePreventivo</td>
                                <td>
                                    @(prev.IdPlantaNavigation?.NombrePlanta ?? "N/A") /
                                    @(prev.IdDepositoNavigation?.NombreDeposito ?? "N/A")
                                </td>
                                <td>@(prev.IdMarcaNavigation?.Descripcion) / 
                                    @(prev.IdModeloNavigation?.Descripcion)</td>
                                <td>@(prev.Fecharegistro?.ToString("dd/MM/yyyy HH:mm"))</td>
                                <td class="text-end">
                                    @if (permisosPagina!.Editar)
                                    {
                                        <a href="~/MantenimientoPreventivo/AgregarPreventivo/@prev.Idpreventivo" class="btn btn-icon btn-active-light-primary w-30px h-30px" title="Editar preventivo">
                                            <i class="ki-outline ki-pencil fs-3"></i>
                                        </a>
                                    }
                                </td>

                               
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/js/logistica/preventivo/table.js" asp-append-version="true"></script>
    <script src="~/assets/js/widgets.bundle.js"></script>
    <script src="~/assets/js/custom/widgets.js"></script>
}