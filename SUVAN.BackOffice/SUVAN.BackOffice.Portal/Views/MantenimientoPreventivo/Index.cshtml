@using SUVAN.BackOffice.Models.ViewModel.Enums;
@using SUVAN.BackOffice.Portal.Helper;
@inject IUsuarioHelper UsuarioHelper
@{
    ViewData["Title"] = "Consulta de Mantenimientos Preventivos";
}
@model List<SUVAN.BackOffice.Database.Entities.Preventivo>
@{
    var permisosPagina = await UsuarioHelper.GetPermisosPagina(User, EnumOpcionMenu.MantenimientoPreventivo);
    if (permisosPagina == null) { return; }

    // Obtener los años únicos de los registros para el filtro de Año
    var aniosDisponibles = Model.Select(p => p.FechaPrev.Year).Distinct().OrderByDescending(y => y).ToList();
}

<div id="kt_app_toolbar" class="app-toolbar">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                <h1 class="page-heading d-flex flex-column justify-content-center text-dark fw-bold fs-3 m-0">@ViewData["Title"]</h1>
            </div>
            <div class="d-flex align-items-center gap-2 gap-lg-3">
                @if (permisosPagina!.Agregar)
                {
                    <a href="~/MantenimientoPreventivo/AgregarPreventivo" class="btn btn-flex btn-outline btn-color-gray-700 btn-active-color-primary bg-body h-40px fs-7 fw-bold">Agregar Preventivo</a>
                }
            </div>
        </div>
    </div>
</div>

<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">
        <div class="d-flex align-items-center mb-8 overflow-auto">
            <a href="~/MantenimientoPreventivo/Index" class="btn btn-primary me-3">Mantenimientos Preventivos</a>
            <a href="~/MantenimientoPreventivo/DetallePreventivos" class="btn btn-light btn-active-primary">Detalle de Preventivos</a>
        </div>

        <div class="card">
            <div class="card-header border-0 pt-6 d-flex flex-column">
                <div class="row g-4 w-100 mb-4">
                    <div class="col-md-6">
                        <div class="d-flex align-items-center position-relative my-1">
                            <i class="ki-outline ki-magnifier fs-3 position-absolute ms-5"></i>
                            <input type="text" id="filtroGeneralMantenimientos" class="form-control form-control-solid ps-13" placeholder="Buscar texto general..." />
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="d-flex align-items-center position-relative my-1" title="Selecciona un mes para filtrar los registros por la fecha prevista">
                            <i class="ki-outline ki-calendar fs-3 position-absolute ms-5"></i>
                            <select id="filtroMes" class="form-select form-select-solid ps-13">
                                <option value="">Mes (Todos)</option>
                                <option value="01">Enero</option>
                                <option value="02">Febrero</option>
                                <option value="03">Marzo</option>
                                <option value="04">Abril</option>
                                <option value="05">Mayo</option>
                                <option value="06">Junio</option>
                                <option value="07">Julio</option>
                                <option value="08">Agosto</option>
                                <option value="09">Septiembre</option>
                                <option value="10">Octubre</option>
                                <option value="11">Noviembre</option>
                                <option value="12">Diciembre</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="d-flex align-items-center position-relative my-1" title="Selecciona un año para filtrar los registros por la fecha prevista">
                            <i class="ki-outline ki-calendar-8 fs-3 position-absolute ms-5"></i>
                            <select id="filtroAnio" class="form-select form-select-solid ps-13">
                                <option value="">Año (Todos)</option>
                                @foreach (var anio in aniosDisponibles)
                                {
                                    <option value="@anio">@anio</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row g-4 w-100 border-top pt-4">
                    <div class="col-md-12">
                        <label class="form-label fs-7 fw-bold text-gray-700 mb-2">Ordenar Por:</label>
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <select id="sortNombre" class="form-select form-select-sm form-select-solid w-150px sort-filter">
                                <option value="">Nombre</option>
                                <option value="asc">Ascendente</option>
                                <option value="desc">Descendente</option>
                            </select>
                            <select id="sortRegion" class="form-select form-select-sm form-select-solid w-150px sort-filter">
                                <option value="">Región</option>
                                <option value="asc">Ascendente</option>
                                <option value="desc">Descendente</option>
                            </select>
                            <select id="sortPlanta" class="form-select form-select-sm form-select-solid w-150px sort-filter">
                                <option value="">Planta</option>
                                <option value="asc">Ascendente</option>
                                <option value="desc">Descendente</option>
                            </select>
                            <select id="sortZona" class="form-select form-select-sm form-select-solid w-150px sort-filter">
                                <option value="">Zona</option>
                                <option value="asc">Ascendente</option>
                                <option value="desc">Descendente</option>
                            </select>
                            <select id="sortDeposito" class="form-select form-select-sm form-select-solid w-150px sort-filter">
                                <option value="">Depósito</option>
                                <option value="asc">Ascendente</option>
                                <option value="desc">Descendente</option>
                            </select>
                            <select id="sortMarca" class="form-select form-select-sm form-select-solid w-150px sort-filter">
                                <option value="">Marca</option>
                                <option value="asc">Ascendente</option>
                                <option value="desc">Descendente</option>
                            </select>
                            <select id="sortModelo" class="form-select form-select-sm form-select-solid w-150px sort-filter">
                                <option value="">Modelo</option>
                                <option value="asc">Ascendente</option>
                                <option value="desc">Descendente</option>
                            </select>
                            <select id="sortCosto" class="form-select form-select-sm form-select-solid w-150px sort-filter">
                                <option value="">Costo Total</option>
                                <option value="asc">Ascendente</option>
                                <option value="desc">Descendente</option>
                            </select>
                            <select id="sortFecha" class="form-select form-select-sm form-select-solid w-150px sort-filter">
                                <option value="">Fecha Prevista</option>
                                <option value="asc">Ascendente</option>
                                <option value="desc">Descendente</option>
                            </select>
                            <button type="button" id="btnLimpiarOrden" class="btn btn-sm btn-light">Limpiar Filtros</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body py-4">
                <div class="table-responsive">
                    <table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_table_preventivo">
                        <thead>
                            <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                                <th>Nombre</th>
                                <th>Región</th>
                                <th>Planta</th>
                                <th>Zona</th>
                                <th>Depósito</th>
                                <th>Marca</th>
                                <th>Modelo</th>
                                <th>Costo Total</th>
                                <th>Fecha Prevista</th>
                                <th class="text-end min-w-100px">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="text-gray-600 fw-semibold">
                            @foreach (var prev in Model)
                            {
                                <tr>
                                    <td>@prev.NombrePreventivo</td>
                                    <td>@(prev.Id?.NombreRegion ?? "-")</td>
                                    <td>@(prev.IdPlantaNavigation?.NombrePlanta ?? "-")</td>
                                    <td>@(prev.IdZonaNavigation?.NombreZona ?? "-")</td>
                                    <td>@(prev.IdDepositoNavigation?.NombreDeposito ?? "-")</td>
                                    <td>@(prev.IdMarcaNavigation?.Descripcion ?? "-")</td>
                                    <td>@(prev.IdModeloNavigation?.Descripcion ?? "-")</td>
                                    <td data-sort="@(prev.CostoTotal ?? 0)"><span class="badge badge-light-success">@((prev.CostoTotal ?? 0).ToString("C"))</span></td>
                                    <td data-sort="@prev.FechaPrev.ToString("yyyyMMdd")">@prev.FechaPrev.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">
                                        <button class="btn btn-icon btn-active-light-primary w-30px h-30px me-1" onclick="abrirModalDetalle(@prev.Idpreventivo)" title="Ver detalles del plan preventivo">
                                            <i class="ki-outline ki-eye fs-3"></i>
                                        </button>
                                        @if (permisosPagina!.Editar)
                                        {
                                            <a href="~/MantenimientoPreventivo/AgregarPreventivo/@prev.Idpreventivo" class="btn btn-icon btn-active-light-primary w-30px h-30px" title="Editar preventivo">
                                                <i class="ki-outline ki-pencil fs-3"></i>
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" tabindex="-1" id="modalDetallePreventivo">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content" id="modalContentAjax">
        </div>
    </div>
</div>

@section scripts {
    <script src="~/js/logistica/preventivo/table.js" asp-append-version="true"></script>
    <script>
        "use strict";

        var KTPreventivoIndex = function () {
        var datatable;

        var initDatatable = function () {
        var table = document.querySelector('#kt_table_preventivo');
        if (!table) return;

        datatable = $(table).DataTable({
        "info": true,
        "order": [],
        "columnDefs": [
        { "orderable": false, "targets": 9 }
        ]
        });

        var sortMap = {
        'sortNombre': 0,
        'sortRegion': 1,
        'sortPlanta': 2,
        'sortZona': 3,
        'sortDeposito': 4,
        'sortMarca': 5,
        'sortModelo': 6,
        'sortCosto': 7,
        'sortFecha': 8
        };

        // Filtros de Orden
        $('.sort-filter').on('change', function () {
        var dir = $(this).val();
        var id = $(this).attr('id');
        $('.sort-filter').not(this).val('');
        if (dir) {
        datatable.order([sortMap[id], dir]).draw();
        } else {
        datatable.order([]).draw();
        }
        });

        // Filtro General de Texto
        $('#filtroGeneralMantenimientos').on('keyup', function () {
        datatable.search(this.value).draw();
        });

        // Lógica de Filtro Combinado para Mes y Año con Regex
        var aplicarFiltroFecha = function () {
        var mes = $('#filtroMes').val();
        var anio = $('#filtroAnio').val();

        // Si no hay ninguno seleccionado, limpiar búsqueda de columna
        if (!mes && !anio) {
        datatable.column(8).search('').draw();
        return;
        }

        // Construye la expresión regular. Formato celda: dd/MM/yyyy
        // ^ = inicio de texto, .{2} = cualquier día de dos digitos
        var regex = '^.{2}/';
        regex += (mes ? mes : '.{2}') + '/'; // Si no hay mes, ignora los 2 dígitos
        regex += (anio ? anio : '.{4}') + '$'; // Si no hay año, ignora los 4 dígitos

        // true para habilitar regex, false para deshabilitar búsqueda inteligente y respetar posiciones
        datatable.column(8).search(regex, true, false).draw();
        };

        $('#filtroMes, #filtroAnio').on('change', aplicarFiltroFecha);

        // Botón Limpiar Todo
        $('#btnLimpiarOrden').on('click', function () {
        $('.sort-filter').val('');
        $('#filtroGeneralMantenimientos').val('');
        $('#filtroMes').val('');
        $('#filtroAnio').val('');
        datatable.search('').columns().search('').order([]).draw();
        });
        };

        return {
        init: function () {
        initDatatable();
        }
        };
        }();

        window.abrirModalDetalle = function (id) {
        fetch('/MantenimientoPreventivo/GetModalDetalle?id=' + id)
        .then(response => response.text())
        .then(html => {
        document.getElementById('modalContentAjax').innerHTML = html;
        var modal = new bootstrap.Modal(document.getElementById('modalDetallePreventivo'));
        modal.show();

        if ($.fn.DataTable.isDataTable('#kt_table_modal_vehiculos')) {
        $('#kt_table_modal_vehiculos').DataTable().destroy();
        }
        $('#kt_table_modal_vehiculos').DataTable({ "info": false, "pageLength": 5 });
        })
        .catch(error => console.error("Error al cargar el modal: ", error));
        };

        KTUtil.onDOMContentLoaded(function () {
        KTPreventivoIndex.init();
        });
    </script>
}