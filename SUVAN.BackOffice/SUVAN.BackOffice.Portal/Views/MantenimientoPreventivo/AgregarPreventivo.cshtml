@using SUVAN.BackOffice.Models.ViewModel.Logistica;
@model PreventivoViewModel
@{
    bool isEdicion = Model.Idpreventivo > 0;
    var isAgregarText = !isEdicion ? "Agregar" : "Editar";
    ViewData["Title"] = isAgregarText + " Mantenimiento Preventivo";
}

<script>
    window.SUVAN = window.SUVAN || {};
    window.SUVAN.Urls = {
        GetPlantas: '@Url.Action("GetPlantasPorRegion", "MantenimientoPreventivo")',
        GetZonas: '@Url.Action("GetZonasPorPlanta", "MantenimientoPreventivo")',
        GetDepositos: '@Url.Action("GetDepositosPorZona", "MantenimientoPreventivo")',
        GetModelos: '@Url.Action("GetModelosPorMarca", "MantenimientoPreventivo")',
        AjaxSave: '@Url.Action("AgregarPreventivoAjax", "MantenimientoPreventivo")',
        AjaxGenerar: '@Url.Action("GenerarDetallesAjax", "MantenimientoPreventivo")'
    };
</script>

<div class="app-toolbar" id="kt_app_toolbar">
    <div class="app-container container-fluid">
        <div class="page-title d-flex justify-content-between">
            <h1 class="page-heading text-dark fw-bold fs-3">@ViewData["Title"]</h1>
            <a href="~/MantenimientoPreventivo/Index" class="btn btn-sm btn-light">Volver</a>
        </div>
    </div>
</div>

<div class="app-content flex-column-fluid">
    <div class="app-container container-fluid">
        <div class="card">
            <div class="card-body py-4">
                <form class="form w-100" id="form_agregar_preventivo">
                    @Html.AntiForgeryToken()
                    <input asp-for="Idpreventivo" type="hidden" />

                    <div class="row">
                        <div class="col-sm-6 mb-8">
                            <label class="required col-form-label">Nombre Preventivo</label>
                            <input asp-for="NombrePreventivo" class="form-control" />
                        </div>
                        <div class="col-sm-6 mb-8">
                            <label class="required col-form-label">Fecha Prevista</label>
                            <input asp-for="FechaPrev" type="date" min="@DateTime.Now.ToString("yyyy-MM-dd")" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-3 mb-8">
                            <label class="required col-form-label">Región</label>
                            <select asp-for="IdRegion" class="form-select" disabled="@isEdicion">
                                <option value="0">-- Seleccione --</option>
                                @foreach (var r in Model.Regiones)
                                {
                                    <option value="@r.Id" selected="@(r.Id == Model.IdRegion ? "selected" : null)">@r.Nombre</option>
                                }
                            </select>
                            @if (isEdicion)
                            {
                                <input type="hidden" asp-for="IdRegion" />
                            }
                        </div>
                        <div class="col-sm-3 mb-8">
                            <label class="required col-form-label">Planta</label>
                            <select asp-for="IdPlanta" class="form-select" disabled="@isEdicion">
                                <option value="0">-- Seleccione --</option>
                                @foreach (var p in Model.Plantas)
                                {
                                    <option value="@p.Id" selected="@(p.Id == Model.IdPlanta ? "selected" : null)">@p.Nombre</option>
                                }
                            </select>
                            @if (isEdicion)
                            {
                                <input type="hidden" asp-for="IdPlanta" />
                            }
                        </div>
                        <div class="col-sm-3 mb-8">
                            <label class="required col-form-label">Zona</label>
                            <select asp-for="IdZona" class="form-select" disabled="@isEdicion">
                                <option value="0">-- Seleccione --</option>
                                @foreach (var z in Model.Zonas)
                                {
                                    <option value="@z.Id" selected="@(z.Id == Model.IdZona ? "selected" : null)">@z.Nombre</option>
                                }
                            </select>
                            @if (isEdicion)
                            {
                                <input type="hidden" asp-for="IdZona" />
                            }
                        </div>
                        <div class="col-sm-3 mb-8">
                            <label class="required col-form-label">Depósito</label>
                            <select asp-for="IdDeposito" class="form-select" disabled="@isEdicion">
                                <option value="0">-- Seleccione --</option>
                                @foreach (var d in Model.Depositos)
                                {
                                    <option value="@d.Id" selected="@(d.Id == Model.IdDeposito ? "selected" : null)">@d.Nombre</option>
                                }
                            </select>
                            @if (isEdicion)
                            {
                                <input type="hidden" asp-for="IdDeposito" />
                            }
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-6 mb-8">
                            <label class="required col-form-label">Marca</label>
                            <select asp-for="IdMarca" class="form-select" disabled="@isEdicion">
                                <option value="0">-- Seleccione --</option>
                                @foreach (var m in Model.Marcas)
                                {
                                    <option value="@m.Id">@m.Nombre</option>
                                }
                            </select>
                            @if (isEdicion)
                            {
                                <input type="hidden" asp-for="IdMarca" />
                            }
                        </div>
                        <div class="col-sm-6 mb-8">
                            <label class="required col-form-label">Modelo</label>
                            <select asp-for="IdModelo" class="form-select" disabled="@isEdicion">
                                <option value="0">-- Seleccione --</option>
                                @foreach (var m in Model.Modelos)
                                {
                                    <option value="@m.Id" selected="@(m.Id == Model.IdModelo ? "selected" : null)">@m.Nombre</option>
                                }
                            </select>
                            @if (isEdicion)
                            {
                                <input type="hidden" asp-for="IdModelo" />
                            }
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-6 mb-8">
                            <label class="required col-form-label">Servicio (Mano de Obra)</label>
                            <select asp-for="IdManoObra" class="form-select">
                                <option value="0">-- Seleccione --</option>
                                @foreach (var mo in Model.ManosObra)
                                {
                                    <option value="@mo.Id">@mo.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-6 mb-8">
                            <label class="col-form-label">Observaciones</label>
                            <textarea asp-for="ObservacionesPreventivo" class="form-control" rows="2"></textarea>
                        </div>
                    </div>

                    <div class="text-end">
                        <button type="submit" id="btn_guardar" class="btn btn-primary">Guardar Registro</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/js/logistica/preventivo/add.js" asp-append-version="true"></script>
}