@using SUVAN.BackOffice.Models.ViewModel.Logistica;
@using SUVAN.BackOffice.Models.ViewModel.Enums;
@using SUVAN.BackOffice.Portal.Helper;
@inject IUsuarioHelper UsuarioHelper
@{
    ViewData["Title"] = "";
}
@model PreventivoViewModel
@{
    var permisosPagina = await UsuarioHelper.GetPermisosPagina(User, EnumOpcionMenu.MantenimientoPreventivo);
    if (permisosPagina == null) { return; }

    // Variable para saber si estamos editando un registro existente
    bool isEdicion = Model.Idpreventivo > 0;
    var isAgregarText = !isEdicion ? "Agregar" : "Editar";
}

<script>
    window.SUVAN = window.SUVAN || {};
    window.SUVAN.Urls = {
        GetDepositos: '@Url.Action("GetDepositosPorPlanta", "MantenimientoPreventivo")',
        GetModelos: '@Url.Action("GetModelosPorMarca", "MantenimientoPreventivo")',
        GenerarPreventivos: '@Url.Action("GenerarDetalles", "MantenimientoPreventivo")'
    };
</script>

<div id="kt_app_toolbar" class="app-toolbar ">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                <a href="~/MantenimientoPreventivo/Index" class="page-heading d-flex justify-content-center align-center text-dark fw-bold fs-3 m-0">
                    <i class="ki-duotone ki-left fs-1 pe-5"></i>
                    <span>@isAgregarText @ViewData["Title"]</span>
                </a>
            </div>
        </div>
    </div>
</div>

<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">
        <div class="card">
            <div class="card-body py-4">
                <form class="form w-100" novalidate="novalidate" id="kt_preventivo_in_form" asp-controller="MantenimientoPreventivo" asp-action="AgregarPreventivo" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="Idpreventivo" type="hidden" />
                    <input asp-for="Idempresa" type="hidden" value="@User.GetEmpresaId()" />

                    <div class="row">
                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="NombrePreventivo" class="col-form-label text-gray-600 required">Nombre Preventivo</label>
                                <input asp-for="NombrePreventivo" class="form-control bg-transparent" placeholder="Nombre del Plan Preventivo" maxlength="70" />
                                <div class="fv-plugins-message-container invalid-feedback"><span asp-validation-for="NombrePreventivo"></span></div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="FechaPrev" class="col-form-label text-gray-600 required">Fecha Prevista</label>
                                <input asp-for="FechaPrev" type="date" class="form-control bg-transparent" />
                                <div class="fv-plugins-message-container invalid-feedback"><span asp-validation-for="FechaPrev"></span></div>
                            </div>
                        </div>
                    </div>


                    <div class="row">
                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="IdPlanta" class="col-form-label text-gray-600 required">Planta</label>
                                 @if (isEdicion)
                                {
                                    <select id="selectIdPlanta" class="form-select bg-transparent" disabled>
                                        <option value="0">-- Seleccione una Planta --</option>
                                        @foreach (var planta in Model.Plantas)
                                        {
                                            <option value="@planta.IdPlanta" selected="@(planta.IdPlanta == Model.IdPlanta ? "selected" : null)">@planta.Nombre</option>
                                        }
                                    </select>
                                    <input type="hidden" asp-for="IdPlanta" />
                                }
                                else
                                {
                                    <select id="selectIdPlanta" name="IdPlanta" class="form-select bg-transparent">
                                        <option value="0">-- Seleccione una Planta --</option>
                                        @foreach (var planta in Model.Plantas)
                                        {
                                            <option value="@planta.IdPlanta" selected="@(planta.IdPlanta == Model.IdPlanta ? "selected" : null)">@planta.Nombre</option>
                                        }
                                    </select>
                                }
                                <div class="fv-plugins-message-container invalid-feedback"><span asp-validation-for="IdPlanta"></span></div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="IdDeposito" class="col-form-label text-gray-600 required">Depósito</label>
                                @if (isEdicion)
                                {
                                    <select id="selectIdDeposito" class="form-select bg-transparent" disabled>
                                        <option value="0">-- Seleccione un Depósito --</option>
                                        @foreach (var dep in Model.Depositos)
                                        {
                                            <option value="@dep.IdDeposito" selected="@(dep.IdDeposito == Model.IdDeposito ? "selected" : null)">@dep.Nombre</option>
                                        }
                                    </select>
                                    <input type="hidden" asp-for="IdDeposito" />
                                }
                                else
                                {
                                    <select id="selectIdDeposito" name="IdDeposito" class="form-select bg-transparent">
                                        <option value="0">-- Seleccione un Depósito --</option>
                                        @foreach (var dep in Model.Depositos)
                                        {
                                            <option value="@dep.IdDeposito" selected="@(dep.IdDeposito == Model.IdDeposito ? "selected" : null)">@dep.Nombre</option>
                                        }
                                    </select>
                                }
                                <div class="fv-plugins-message-container invalid-feedback"><span asp-validation-for="IdDeposito"></span></div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="IdMarca" class="col-form-label text-gray-600 required">Marca</label>
                                @if (isEdicion)
                                {
                                    <select id="selectIdMarca" class="form-select bg-transparent" disabled>
                                        <option value="0">-- Seleccione una Marca --</option>
                                        @foreach (var marca in Model.Marcas)
                                        {
                                            <option value="@marca.IdMarca" selected="@(marca.IdMarca == Model.IdMarca ? "selected" : null)">@marca.Nombre</option>
                                        }
                                    </select>
                                    <input type="hidden" asp-for="IdMarca" />
                                }
                                else
                                {
                                    <select id="selectIdMarca" name="IdMarca" class="form-select bg-transparent">
                                        <option value="0">-- Seleccione una Marca --</option>
                                        @foreach (var marca in Model.Marcas)
                                        {
                                            <option value="@marca.IdMarca" selected="@(marca.IdMarca == Model.IdMarca ? "selected" : null)">@marca.Nombre</option>
                                        }
                                    </select>
                                }
                                <div class="fv-plugins-message-container invalid-feedback"><span asp-validation-for="IdMarca"></span></div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="IdModelo" class="col-form-label text-gray-600 required">Modelo</label>
                                @if (isEdicion)
                                {
                                    <select id="selectIdModelo" class="form-select bg-transparent" disabled>
                                        <option value="0">-- Seleccione un Modelo --</option>
                                        @foreach (var mod in Model.Modelos)
                                        {
                                            <option value="@mod.IdModelo" selected="@(mod.IdModelo == Model.IdModelo ? "selected" : null)">@mod.Nombre</option>
                                        }
                                    </select>
                                    <input type="hidden" asp-for="IdModelo" />
                                }
                                else
                                {
                                    <select id="selectIdModelo" name="IdModelo" class="form-select bg-transparent">
                                        <option value="0">-- Seleccione un Modelo --</option>
                                        @foreach (var mod in Model.Modelos)
                                        {
                                            <option value="@mod.IdModelo" selected="@(mod.IdModelo == Model.IdModelo ? "selected" : null)">@mod.Nombre</option>
                                        }
                                    </select>
                                }
                                <div class="fv-plugins-message-container invalid-feedback"><span asp-validation-for="IdModelo"></span></div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="IdManoObra" class="col-form-label text-gray-600 required">Mano de Obra</label>
                                <select id="selectIdManoObra" name="IdManoObra" class="form-select bg-transparent">
                                    <option value="0">-- Seleccione Mano de Obra --</option>
                                    @foreach (var mo in Model.ManosObra)
                                    {
                                        <option value="@mo.IdManoObra" selected="@(mo.IdManoObra == Model.IdManoObra ? "selected" : null)">@mo.Descripcion</option>
                                    }
                                </select>
                                <div class="fv-plugins-message-container invalid-feedback"><span asp-validation-for="IdManoObra"></span></div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="ObservacionesPreventivo" class="col-form-label text-gray-600">Observaciones</label>
                                <textarea asp-for="ObservacionesPreventivo" class="form-control bg-transparent" rows="2" placeholder="Observaciones generales"></textarea>
                            </div>
                        </div>
                        </div>

                    <div class="mb-10 text-end">
                        
                            <button type="button" id="btn_generar_preventivos" class="btn btn-primary me-2">
                                <span class="indicator-label">Generar Preventivos</span>
                                <span class="indicator-progress">Procesando... <span class="spinner-border spinner-border-sm align-middle ms-2"></span></span>
                            </button>
                        
                        <button type="submit" id="kt_preventivo_in_submit" class="btn btn-primary">
                            <span class="indicator-label">Guardar</span>
                            <span class="indicator-progress">Por favor espere... <span class="spinner-border spinner-border-sm align-middle ms-2"></span></span>
                        </button>
                    </div> 
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/assets/js/widgets.bundle.js"></script>
    <script src="~/assets/js/custom/widgets.js"></script>
    <script src="~/js/logistica/preventivo/add.js" asp-append-version="true"></script>
}