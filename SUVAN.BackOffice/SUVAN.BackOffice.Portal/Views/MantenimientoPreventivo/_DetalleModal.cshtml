@using SUVAN.BackOffice.Models.ViewModel.Logistica
@model DetalleGeneralViewModel
@{
    var vehiculos = ViewBag.Vehiculos as List<DetPrevMoItemViewModel> ?? new List<DetPrevMoItemViewModel>();
}
<div class="modal-header">
    <h3 class="modal-title">Detalle de Plan Preventivo: @Model.NombrePreventivo</h3>
    <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
        <i class="ki-duotone ki-cross fs-1"><span class="path1"></span><span class="path2"></span></i>
    </div>
</div>

<div class="modal-body">
    <div class="d-flex flex-wrap fw-semibold fs-6 mb-4">
        <span class="me-5"><i class="ki-outline ki-shop fs-4 me-1"></i> Planta/Dep: @Model.Planta / @Model.Deposito</span>
        <span class="me-5"><i class="ki-outline ki-car fs-4 me-1"></i> @Model.Marca / @Model.Modelo</span>
        <span class="me-5"><i class="ki-outline ki-calendar fs-4 me-1"></i> Fecha: @Model.FechaPrev.ToString("dd/MM/yyyy")</span>
    </div>

    <div class="d-flex flex-wrap mb-6">
        <div class="border border-dashed rounded min-w-125px py-3 px-4 me-4 mb-3">
            <div class="fs-2 fw-bold">@Model.CostoUnitario.ToString("C")</div>
            <div class="fw-semibold fs-7 text-gray-400">Costo Base/Unidad</div>
        </div>
        <div class="border border-dashed rounded min-w-125px py-3 px-4 me-4 mb-3">
            <div class="fs-2 fw-bold">@Model.IvaUnitario.ToString("C")</div>
            <div class="fw-semibold fs-7 text-gray-400">IVA por Unidad</div>
        </div>
        <div class="border border-dashed rounded min-w-125px py-3 px-4 mb-3">
            <div class="fs-2 fw-bold text-success">@Model.CostoTotal.ToString("C")</div>
            <div class="fw-semibold fs-7 text-gray-400">Gran Total</div>
        </div>
    </div>

    <h4>Detalle de Vehículos Coincidentes</h4>
    <table class="table align-middle table-row-dashed fs-6 gy-3" id="kt_table_modal_vehiculos">
        <thead>
            <tr class="text-start text-gray-400 fw-bold fs-7 text-uppercase gs-0">
                <th>Servicio</th>
                <th>Vehículo (Placas/VIN)</th>
                <th>Monto IVA</th>
                <th>Costo total por unidad</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var v in vehiculos)
            {
                <tr>
                    <td>@v.ManoObra</td>
                    <td><b>@v.Placas</b><br /><span class="text-muted">@v.Vin</span></td>
                    <td>@v.Iva?.ToString("C")</td>
                    <td><span class="badge badge-light-info">@v.CostoTotalUnitario.ToString("C")</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>