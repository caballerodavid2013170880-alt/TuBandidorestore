@using SUVAN.BackOffice.Models.ViewModel.Logistica;
@model List<DetalleGeneralViewModel>
@{
    ViewData["Title"] = "Mantenimiento Preventivo - Detalle General";
}

<style>
    /* Mismos estilos compartidos para pestañas */
    .nav-tab-custom {
        color: #7E8299;
        font-weight: 500;
        padding: 0.65rem 1.25rem;
        border-radius: 0.475rem;
        transition: all 0.2s ease;
        text-decoration: none;
        margin-right: 1rem;
    }

        .nav-tab-custom:hover {
            color: #0052cc;
        }

    .nav-tab-active {
        background-color: #0052cc;
        color: #ffffff !important;
        font-weight: 600;
        box-shadow: 0 0 0 4px #d6e4f9;
    }
</style>

<div id="kt_app_toolbar" class="app-toolbar ">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                <h1 class="page-heading d-flex flex-column justify-content-center text-dark fw-bold fs-3 m-0">@ViewData["Title"]</h1>
            </div>
        </div>
    </div>
</div>

<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">

        <!-- PESTAÑAS (Activo: Detalle General) -->
        <div class="d-flex align-items-center mb-8 overflow-auto">
            <a href="~/MantenimientoPreventivo/Index" class="nav-tab-custom">Planes Preventivos</a>
            <a href="~/MantenimientoPreventivo/IndexDetalleGeneral" class="nav-tab-custom nav-tab-active">Detalle General</a>
            <a href="~/MantenimientoPreventivo/IndexDetalleUnitario" class="nav-tab-custom">Detalle Unitario</a>
        </div>

        <div class="card card-flush">
            <div class="card-header border-0 pt-6">
                <div class="card-title">
                    <div class="d-flex align-items-center position-relative my-1">
                        <i class="ki-outline ki-magnifier fs-3 position-absolute ms-5"></i>
                        <input type="text" data-kt-preventivo-table-filter="search" class="form-control form-control-solid w-450px ps-13" placeholder="Buscar detalle preventivo..." />
                    </div>
                </div>
            </div>

            <div class="card-body pt-6">
                <table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_table_det_prev">
                    <thead>
                        <tr class="text-start text-gray-400 fw-bold fs-7 text-uppercase gs-0">
                            <th>Plan Preventivo</th>
                            <th>Fecha Prevista</th>
                            <th>Costo por vehículo </th>
                            <th>Costo Total</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="fw-semibold text-gray-600">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="text-dark fw-bold">@item.NombrePreventivo</span></td>
                                <td>@item.FechaPrev.ToString("dd/MM/yyyy")</td>
                                <td>@item.CostoUnitario.ToString("C")</td>
                                <td><span class="badge badge-light-success">@item.CostoTotal.ToString("C")</span></td>
                                <td class="text-end">
                                    <!-- Botón Ojo redirigiendo al Detalle particular de ese plan -->
                                    <a href="~/MantenimientoPreventivo/DetalleGeneral/@item.IdPreventivo" class="btn btn-icon btn-light-info btn-active-info w-30px h-30px" title="Ver Consulta Detallada">
                                        <i class="ki-outline ki-eye fs-3"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/js/administrativo/preventivo/det_general.js" asp-append-version="true"></script>
}