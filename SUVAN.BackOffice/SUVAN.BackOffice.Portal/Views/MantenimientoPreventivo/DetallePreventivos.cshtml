@{
    ViewData["Title"] = "Detalle de Preventivos";
    var listaPlanes = ViewBag.ListaPreventivos as List<SUVAN.BackOffice.Models.ViewModel.Logistica.PreventivoViewModel.CatalogItemViewModel>;
}

<div id="kt_app_toolbar" class="app-toolbar">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                <h1 class="page-heading d-flex flex-column justify-content-center text-dark fw-bold fs-3 m-0">@ViewData["Title"]</h1>
            </div>
        </div>
    </div>
</div>

<div id="kt_app_content" class="app-content flex-column-fluid">
    <div class="app-container container-fluid">
        <div class="d-flex align-items-center mb-8 overflow-auto">
            <a href="~/MantenimientoPreventivo/Index" class="btn btn-light btn-active-primary me-3">Mantenimientos Preventivos</a>
            <a href="~/MantenimientoPreventivo/DetallePreventivos" class="btn btn-primary">Detalle de Preventivos</a>
        </div>

        <div class="card mb-5">
            <div class="card-body py-4 d-flex align-items-center">
                <span class="fs-5 fw-bold me-4">Seleccione un Mantenimiento Preventivo:</span>
                @{
                    var preventivoSeleccionado = listaPlanes?.FirstOrDefault(x => x.Id == ViewBag.IdPreventivoSeleccionado);
                    var nombrePreventivoSeleccionado = preventivoSeleccionado?.Nombre ?? "";
                }
                <div class="input-group input-group-sm w-400px">
                    <input type="text" id="PreventivoGlobalVisible" value="@nombrePreventivoSeleccionado" class="form-control form-control-sm bg-transparent bg-light text-muted" placeholder="Lista de Mantenimientos Preventivos" data-catalog-for="selectPreventivoGlobal" readonly disabled />
                    <span class="input-group-text" style="cursor:pointer;">
                        <i class="fas fa-search show-modal-catalog" data-suvan-catalog="preventivo" data-suvan-catalog-description="nombrePreventivo"></i>
                    </span>
                </div>
                <input type="hidden" id="selectPreventivoGlobal" name="selectPreventivoGlobal" value="@ViewBag.IdPreventivoSeleccionado" />
            </div>
        </div>

        <div id="detalleCompletoContainer" style="display:none;">
            <div class="card mb-5 mb-xl-10">
                <div class="card-body pt-9 pb-0">
                    <div class="d-flex justify-content-between">
                        <div class="d-flex flex-column">
                            <span class="text-gray-900 fs-2 fw-bold mb-2" id="lblNombre">Cargando...</span>
                            <div class="d-flex flex-wrap fw-semibold fs-6 mb-4">
                                <span class="me-5"><i class="ki-outline ki-shop fs-4 me-1"></i> <span id="lblUbicacion"></span></span>
                                <span class="me-5"><i class="ki-outline ki-car fs-4 me-1"></i> <span id="lblVehiculo"></span></span>
                                <span class="me-5"><i class="ki-outline ki-calendar fs-4 me-1"></i> Fecha Prevista: <span id="lblFechaPrev"></span></span>
                            </div>
                        </div>
                        <div class="text-end">
                            <span class="badge badge-light-primary fs-7">Creado: <span id="lblFechaRegistro"></span></span>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap flex-stack mt-2">
                        <div class="d-flex flex-wrap">
                            <div class="border border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
                                <div class="fs-2 fw-bold" id="lblCostoBase"></div><div class="fs-7 text-gray-400">Costo Base/Unidad</div>
                            </div>
                            <div class="border border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
                                <div class="fs-2 fw-bold" id="lblIvaUnidad"></div><div class="fs-7 text-gray-400">IVA por Unidad</div>
                            </div>
                            <div class="border border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
                                <div class="fs-2 fw-bold text-success" id="lblGranTotal"></div><div class="fs-7 text-gray-400">Gran Total (Masivo)</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card card-flush">
                <div class="card-header border-0 pt-6 d-flex flex-column">
                    <h3 class="card-title fw-bold">Detalle de Vehículos</h3>
                    <div class="row w-100 mt-2 mb-2">
                        <div class="col-md-3"><input type="text" id="fvPlacas" class="form-control form-control-solid" placeholder="Filtrar por Placas..." /></div>
                        <div class="col-md-3"><input type="text" id="fvVin" class="form-control form-control-solid" placeholder="Filtrar por VIN..." /></div>
                    </div>
                    <div class="row w-100 mt-2">
                        <div class="col-md-12 d-flex align-items-center gap-2">
                            <span class="fw-bold text-gray-700">Ordenar por:</span>
                            <select id="sortPlacas" class="form-select form-select-sm form-select-solid w-150px">
                                <option value="">Placas</option>
                                <option value="asc">Ascendente</option>
                                <option value="desc">Descendente</option>
                            </select>
                            <select id="sortVin" class="form-select form-select-sm form-select-solid w-150px">
                                <option value="">VIN</option>
                                <option value="asc">Ascendente</option>
                                <option value="desc">Descendente</option>
                            </select>
                            <button id="btnLimpiarOrden" class="btn btn-sm btn-light">Limpiar Orden</button>
                        </div>
                    </div>
                </div>
                <div class="card-body pt-0">
                    <table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_table_vehiculos_consolidado">
                        <thead>
                            <tr class="text-start text-gray-400 fw-bold fs-7 text-uppercase gs-0">
                                <th>Servicio</th>
                                <th>Placas</th>
                                <th>VIN</th>
                                <th>Costo total unitario</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyVehiculos"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" tabindex="-1" id="modalInfoVehiculo">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Detalle Unitario de Vehículo</h3>
                <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal">
                    <i class="ki-duotone ki-cross fs-1"></i>
                </div>
            </div>
            <div class="modal-body" id="modalInfoVehiculoBody"></div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/js/administrativo/preventivo/detalle_preventivos.js" asp-append-version="true"></script>
}