@using SUVAN.BackOffice.Models.ViewModel.Logistica;
@model DetalleGeneralViewModel

@{
    ViewData["Title"] = "Detalle General Preventivo";
}

<div id="kt_app_toolbar" class="app-toolbar">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                <a href="~/MantenimientoPreventivo/Index" class="page-heading d-flex justify-content-center align-center text-dark fw-bold fs-3 m-0">
                    <i class="ki-duotone ki-left fs-1 pe-5"></i>
                    <span>@ViewData["Title"]</span>
                </a>
            </div>
        </div>
    </div>
</div>

<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">

        <!-- Cabecera de Datos Básicos -->
        <div class="card mb-5 mb-xl-10">
            <div class="card-header cursor-pointer">
                <div class="card-title m-0">
                    <h3 class="fw-bold m-0">Resumen del Plan: @Model.NombrePreventivo</h3>
                </div>
            </div>
            <div class="card-body p-9">
                <div class="row mb-7">
                    <label class="col-lg-4 fw-semibold text-muted">Marca / Modelo</label>
                    <div class="col-lg-8"><span class="fw-bold fs-6 text-gray-800">@Model.Marca / @Model.Modelo</span></div>
                </div>
                <div class="row mb-7">
                    <label class="col-lg-4 fw-semibold text-muted">Fecha del Preventivo</label>
                    <div class="col-lg-8"><span class="fw-bold fs-6 text-gray-800">@Model.FechaPrev.ToString("dd/MM/yyyy")</span></div>
                </div>
                <div class="row mb-7">
                    <label class="col-lg-4 fw-semibold text-muted">Costo Unitario Base</label>
                    <div class="col-lg-8"><span class="fw-bold fs-6 text-gray-800">@Model.CostoUnitario.ToString("C")</span></div>
                </div>
                <div class="row mb-7">
                    <label class="col-lg-4 fw-semibold text-muted">IVA Total</label>
                    <div class="col-lg-8"><span class="fw-bold fs-6 text-gray-800">@Model.IvaTotal.ToString("C")</span></div>
                </div>
                <div class="row mb-7">
                    <label class="col-lg-4 fw-semibold text-muted">Gran Total Global</label>
                    <div class="col-lg-8"><span class="fw-bolder fs-6 text-success">@Model.CostoTotal.ToString("C")</span></div>
                </div>
            </div>
        </div>

        <!-- Tabla Detalle Masivo (det_prev) -->
        <div class="card">
            <div class="card-header border-0 pt-6">
                <div class="card-title">
                    <h3 class="fw-bold m-0">Registro Masivo (det_prev)</h3>
                </div>
            </div>
            <div class="card-body py-4">
                <table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_table_detalle_general">
                    <thead>
                        <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                            <th class="min-w-100px">ID Detalle</th>
                            <th class="min-w-150px">Costo Unitario</th>
                            <th class="min-w-100px">IVA</th>
                            <th class="min-w-150px">Costo Total</th>
                            <th class="text-end min-w-150px">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="text-gray-600 fw-semibold">
                        @foreach (var det in Model.Detalles)
                        {
                            <tr>
                                <td>@det.IdPrevDet</td>
                                <td>@det.CostoUnitario.ToString("C")</td>
                                <td>@det.Iva.ToString("C")</td>
                                <td>@det.CostoTotal.ToString("C")</td>
                                <td class="text-end">
                                    <a href="~/MantenimientoPreventivo/DetallePreventivoMO/@Model.IdPreventivo" class="btn btn-sm btn-light-primary">
                                        Ver Vehículos coincidentes
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/js/logistica/preventivo/detalleGeneral.js" asp-append-version="true"></script>
}