@using SUVAN.BackOffice.Models.ViewModel.Logistica
@model DetalleGeneralViewModel
@{
    ViewData["Title"] = "Detalle de Mantenimiento Preventivo";
}

<link href="~/css/logistica/preventivo/tabs-preventivo.css" rel="stylesheet" type="text/css" />

<div class="app-toolbar" id="kt_app_toolbar">
    <div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">
                @ViewData["Title"] - @Model.NombrePreventivo
            </h1>
        </div>
    </div>
</div>

<div class="app-content flex-column-fluid" id="kt_app_content">
    <div class="app-container container-fluid">
        <div class="d-flex align-items-center mb-8 overflow-auto">
            <a href="~/MantenimientoPreventivo/Index" class="nav-tab-custom">Mantenimientos</a>
            <a href="~/MantenimientoPreventivo/DetallePreventivos" class="nav-tab-custom nav-tab-active">Detalle de Preventivos</a>
        </div>

        <div class="card mb-5 mb-xl-10">
            <div class="card-body pt-9 pb-0">
                <div class="d-flex flex-wrap flex-sm-nowrap">
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start flex-wrap mb-2">
                            <div class="d-flex flex-column">
                                <span class="text-gray-900 fs-2 fw-bold me-1">@Model.NombrePreventivo</span>
                                <div class="d-flex flex-wrap fw-semibold fs-6 mb-4 pe-2">
                                    <span class="text-gray-400 me-5 mb-2"><i class="ki-outline ki-geolocation fs-4 me-1"></i> Planta: @Model.Planta</span>
                                    <span class="text-gray-400 me-5 mb-2"><i class="ki-outline ki-shop fs-4 me-1"></i> Depósito: @Model.Deposito</span>
                                    <span class="text-gray-400 me-5 mb-2"><i class="ki-outline ki-calendar fs-4 me-1"></i> Fecha Prevista: @Model.FechaPrev.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap">
                            <div class="border border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
                                <div class="fs-2 fw-bold">@Model.CostoUnitario.ToString("C")</div>
                                <div class="fw-semibold fs-6 text-gray-400">Costo Base/Unidad</div>
                            </div>
                            <div class="border border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
                                <div class="fs-2 fw-bold">@Model.IvaUnitario.ToString("C")</div>
                                <div class="fw-semibold fs-6 text-gray-400">IVA por Unidad</div>
                            </div>
                            <div class="border border-dashed rounded min-w-125px py-3 px-4 mb-3">
                                <div class="fs-2 fw-bold text-success">@Model.CostoTotal.ToString("C")</div>
                                <div class="fw-semibold fs-6 text-gray-400">Gran Total</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<h3>Detalle de Vehículos</h3>
<table class="table align-middle table-row-dashed fs-6 gy-5">
    <thead><tr><th>Servicio</th><th>Vehículo</th><th>Total</th></tr></thead>
    <tbody>
        @foreach (var v in (List<DetPrevMoItemViewModel>)ViewBag.Vehiculos)
        {
            <tr><td>@v.ManoObra</td><td>@v.Placas</td><td>@v.CostoTotalUnitario.ToString("C")</td></tr>
        }
    </tbody>
</table>