@using SUVAN.BackOffice.Models.ViewModel.Logistica;
@model PreventivoViewModel
@{
    ViewData["Title"] = "Consulta de Mantenimientos Preventivos";
    var listaPreventivos = ViewBag.ListaPreventivos as List<SUVAN.BackOffice.Database.Entities.Preventivo>;
}

<div id="kt_app_toolbar" class="app-toolbar">
    <div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title"><h1 class="page-heading text-dark fw-bold fs-3">@ViewData["Title"]</h1></div>
    </div>
</div>

<div id="kt_app_content" class="app-content flex-column-fluid">
    <div class="app-container container-fluid">

        <div class="card mb-7">
            <div class="card-body">
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fs-7 fw-bold text-gray-700">Nombre de Mantenimiento</label>
                        <input type="text" id="fcNombre" class="form-control form-control-sm" placeholder="Buscar por nombre..." />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fs-7 fw-bold text-gray-700">Fecha Prevista (Exacta)</label>
                        <input type="date" id="fcFecha" class="form-control form-control-sm" />
                    </div>
                </div>

                <div class="row g-4 border-top pt-4">
                    <div class="col-md-6 d-flex align-items-center">
                        <label class="form-label fs-7 fw-bold text-gray-700 me-4 mb-0">Ordenar Por:</label>
                        <select id="sortColumn" class="form-select form-select-sm w-150px me-2">
                            <option value="0">Nombre</option>
                            <option value="5">Costo Total</option>
                            <option value="4">Fecha Prevista</option>
                        </select>
                        <select id="sortDirection" class="form-select form-select-sm w-150px">
                            <option value="asc">Ascendente</option>
                            <option value="desc">Descendente</option>
                        </select>
                        <button type="button" id="btnSort" class="btn btn-sm btn-primary ms-3">Aplicar Orden</button>
                    </div>
                    <div class="col-md-6 text-end">
                        <button type="button" id="btnClearFilters" class="btn btn-sm btn-light">Limpiar Filtros</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body py-4">
                <div class="table-responsive">
                    <table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_table_consulta">
                        <thead>
                            <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                                <th>Nombre</th>
                                <th>Depósito</th>
                                <th>Marca</th>
                                <th>Modelo</th>
                                <th>Fecha Prevista</th>
                                <th>Costo Total</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="text-gray-600 fw-semibold">
                            @foreach (var prev in listaPreventivos)
                            {
                                <tr>
                                    <td>@prev.NombrePreventivo</td>
                                    <td>@(prev.IdDepositoNavigation?.NombreDeposito ?? "-")</td>
                                    <td>@(prev.IdMarcaNavigation?.Descripcion ?? "-")</td>
                                    <td>@(prev.IdModeloNavigation?.Descripcion ?? "-")</td>
                                    <td data-sort="@prev.FechaPrev.ToString("yyyyMMdd")">@prev.FechaPrev.ToString("dd/MM/yyyy")</td>
                                    <td><span class="badge badge-light-success">@((prev.CostoTotal ?? 0).ToString("C"))</span></td>
                                    <td class="text-end">
                                        <button class="btn btn-icon btn-light btn-active-light-primary w-30px h-30px" onclick="abrirModalDetalle(@prev.Idpreventivo)" title="Ver detalles">
                                            <i class="ki-outline ki-eye fs-3"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" tabindex="-1" id="modalDetallePreventivo">
    <div class="modal-dialog modal-xl modal-dialog-centered"><div class="modal-content" id="modalContentAjax"></div></div>
</div>

@section scripts {
    <script src="~/js/logistica/preventivo/consulta.js" asp-append-version="true"></script>
    <script>
        function abrirModalDetalle(id) {
        fetch('/MantenimientoPreventivo/GetModalDetalle?id=' + id).then(response => response.text()).then(html => {
        document.getElementById('modalContentAjax').innerHTML = html;
        var modal = new bootstrap.Modal(document.getElementById('modalDetallePreventivo'));
        modal.show();
        $('#kt_table_modal_vehiculos').DataTable({ "info": false, "pageLength": 5 });
        });
        }
    </script>
}