@using SUVAN.BackOffice.Models.ViewModel.Enums;
@using SUVAN.BackOffice.Portal.Helper;
@inject IUsuarioHelper UsuarioHelper

@{
    ViewData["Title"] = "Cargas Transitorias";
}

@{
    var permisosPagina = await UsuarioHelper.GetPermisosPagina(User, EnumOpcionMenu.empresas);
    if (permisosPagina == null)
    {
        return;
    }
}
<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar ">
    <!--begin::Toolbar container-->
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
        <!--begin::Toolbar wrapper-->
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <!--begin::Page title-->
            <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                <!--begin::Title-->
                <h1 class="page-heading d-flex flex-column justify-content-center text-dark fw-bold fs-3 m-0">@ViewData["Title"]</h1>
                <!--end::Title-->
            </div>
            <!--end::Page title-->
            <!--begin::Actions-->
            <div class="d-flex align-items-center gap-2 gap-lg-3">

                @if (permisosPagina!.Agregar)
                {
                    <a href="~/combustible/agregarcarga" class="btn btn-flex btn-outline btn-color-gray-700 btn-active-color-primary bg-body h-40px fs-7 fw-bold">Agregar Carga Manual</a>
                }
                <button id="btnGuardarBase" class="btn btn-flex btn-primary h-40px fs-7 fw-bold d-none">Cargar a BASE</button>
            </div>
            <!--end::Actions-->
        </div>
        <!--end::Toolbar wrapper-->
    </div>
    <!--end::Toolbar container-->
</div>
<!--end::Toolbar-->
<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <!--begin::Content container-->
    <div id="kt_app_content_container" class="app-container container-fluid">
        <!--begin::Card-->
        <div class="card">
            <!--begin::Card header-->
            <div class="card-header border-0 pt-6">
                <!--begin::Card title-->
                <div class="card-title">
                    <!--begin::Search-->
                    <div class="d-flex align-items-center position-relative my-1">
                        <i class="ki-outline ki-magnifier fs-3 position-absolute ms-5"></i>
                        <input type="text" id="txtBuscarGrid" class="form-control form-control-solid w-450px ps-13" placeholder="Buscar..." disabled />
                    </div>
                    <!--end::Search-->
                </div>
                <!--begin::Card title-->

            </div>
            <!--end::Card header-->
            <!--begin::Card body-->
            <div class="row w-100 m-0">
                <div class="col-md-3">
                    <label class="form-label fw-bold text-dark fs-7">Region: </label>
                    <select id="cmbRegion" class="form-select form-select-solid fs-7">
                        <option value="">Seleccione una Región</option>
                        @if (ViewBag.Regiones !=null)
                        {
                            foreach (var reg in ViewBag.Regiones)
                            {
                                <option value="@reg.Id">@reg.Nombre</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold text-dark fs-7">Planta: </label>
                    <select id="cmbPlanta" class="form-select form-select-solid fs-7" disabled>
                        <option value="">Seleccione una Planta...</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold text-dark fs-7">Zona: </label>
                    <select id="cmbZona" class="form-select form-select-solid fs-7" disabled>
                        <option value="">Seleccione una Zonaa...</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold text-dark fs-7">Depósito: </label>
                    <select id="cmbDeposito" class="form-select form-select-solid fs-7" disabled>
                        <option value="">Seleccione un Depósito...</option>
                    </select>
                </div>
            </div>

           <!--begin::Table-->
        <div class="card-body py-4">
            <div class="table-responsive">
                <table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_table_cargas_transitorias">
                    <thead>
                        <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">

                            @* <th class="min-w-125px">Vehículo</th> *@
                            <th class="min-w-80px">Núm Económico</th>
                            <th class="min-w-90px">Marca</th>
                            <th class="min-w-80px">Modelo</th>
                            <th class="min-w-80px">Placa</th>
                            @* <th class="min-w-125px">Hora</th>
                            <th class="min-w-125px">Folio</th> *@
                            <th class="min-w-90px">Fecha</th>
                            <th class="min-w-80px">Importe</th>
                            @* <th class="text-end min-w-100px">Kms. Anterior</th> *@
                            @* <th class="text-end min-w-100px">Recorridos</th> *@
                            <th class="text-end min-w-70px">Litros</th>
                            @* <th class="text-end min-w-100px">Km. x Lt.</th> *@
                            <th class="text-end min-w-80px">Costo x Lt.</th>
                            <th class="text-end min-w-80px">Kms. Actual</th>
                            @* <th class="text-end min-w-100px">Traspasar</th> *@
                        </tr>
                    </thead>
                    <tbody id="tbodyCargas" class="text-gray-600 fw-semibold">
                        <tr>
                            <td colspan="5" class="text-center" text-muted py-10">Seleccione un depósito para consultar las cargas transitorias. </td>
                        </tr>
                    </tbody>
                </table>
                <!--end::Table-->
            </div>
            <!--end::Card body-->
        </div>
        </div>
        <!--end::Card-->
    </div>
    <!--end::Content container-->
</div>
<!--end::Content-->
@section scripts {

    <script src="~/js/administrativo/cargasTransitorias/table.js" asp-append-version="true"></script>
    
}