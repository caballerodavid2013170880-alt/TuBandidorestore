@using SUVAN.BackOffice.Models.ViewModel.Enums;
@using SUVAN.BackOffice.Portal.Helper;

@{
    ViewData["Title"] = "Agregar Carga Manual";
}

<div id="kt_app_toolbar" class="app-toolbar">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                <h1 class="page-heading d-flex flex-column justify-content-center text-dark fw-bold fs-3 m-0">
                    @ViewData["Title"]
                </h1>
            </div>
            <div class="d-flex align-items-center gap-2 gap-lg-3">
                <a asp-controller="Combustible" asp-action="CargasTransitorias" class="btn btn-flex btn-light h-40px fs-7 fw-bold">
                    Regresar al Listado
                </a>
            </div>
        </div>
    </div>
</div>
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">
        <div class="card">
            <div class="card-body p-10">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger d-flex align-items-center p-5 mb-5">
                        <i class="ki-outline ki-shield-search fs-2hx text-danger me-4"></i>
                        <div class="d-flex flex-column">
                            <h4 class="mb-1 text-danger">No se pudo guardar la carga</h4>
                            <span>@ViewBag.Error</span>
                        </div>
                    </div>
                }
                <form id="kt_cargas_in_form" class="form d-flex flex-column gap-7" method="post" action="~/Combustible/SaveCargas">

                    <h5 class="text-dark fw-bold mb-3">Ubicación de la Carga</h5>
                    <div class="row g-9">
                        <div class="col-md-3 fv-row">
                            <label class="required form-label fw-bold text-dark fs-7">Región</label>
                            <select name="IdRegion" id="IdRegion" class="form-select form-select-solid fs-7">
                                <option value="">Seleccione una Región...</option>
                                @if (ViewBag.Regiones != null)
                                {
                                    foreach (var reg in ViewBag.Regiones)
                                    {
                                        <option value="@reg.Id">@reg.Nombre</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3 fv-row">
                            <label class="required form-label fw-bold text-dark fs-7">Planta</label>
                            <select name="IdPlanta" class="form-select form-select-solid fs-7" disabled>
                                <option value="0">Selecciona una planta...</option>
                            </select>
                        </div>
                        <div class="col-md-3 fv-row">
                            <label class="required form-label fw-bold text-dark fs-7">Zona</label>
                            <select name="IdZona" class="form-select form-select-solid fs-7" disabled>
                                <option value="0">Selecciona una zona...</option>
                            </select>
                        </div>
                        <div class="col-md-3 fv-row">
                            <label class="required form-label fw-bold text-dark fs-7">Depósito</label>
                            <select name="IdDeposito" class="form-select form-select-solid fs-7" disabled>
                                <option value="0">Selecciona un depósito...</option>
                            </select>
                        </div>
                    </div>

                    <div class="separator my-2"></div>

                    <h5 class="text-dark fw-bold mb-3">Identificación de la Nota</h5>
                    <div class="row g-9">
                        <div class="col-md-3 fv-row">
                            <label class="required form-label fw-bold text-dark fs-7">Vehículo Económico</label>
                            <input type="text" name="VehiculoEconomico" class="form-control form-control-solid fs-7" placeholder="Ej. 3066" />
                        </div>
                        <div class="col-md-3 fv-row">
                            <label class="required form-label fw-bold text-dark fs-7">Folio Nota</label>
                            <input type="text" name="FolioNota" class="form-control form-control-solid fs-7" placeholder="Número de Folio" />
                        </div>
                        <div class="col-md-3 fv-row">
                            <label class="required form-label fw-bold text-dark fs-7">Fecha</label>
                            <input type="date" name="Fecha" class="form-control form-control-solid fs-7" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-3 fv-row">
                            <label class="required form-label fw-bold text-dark fs-7">Hora</label>
                            <input type="time" name="Hora" class="form-control form-control-solid fs-7" value="@DateTime.Now.ToString("HH:mm")" />
                        </div>
                    </div>

                    <div class="separator my-2"></div>

                    <h5 class="text-dark fw-bold mb-3">Kilometrajes e Importes</h5>
                    <div class="row g-9">
                        <div class="col-md-4 fv-row">
                            <label class="required form-label fw-bold text-dark fs-7">Kms. Anterior</label>
                            <input type="number" id="txtKmAnteriorManual" name="KmAnterior" class="form-control form-control-solid fs-7" placeholder="0" />
                        </div>
                        <div class="col-md-4 fv-row">
                            <label class="required form-label fw-bold text-dark fs-7">Kms. Actual</label>
                            <input type="number" id="txtKmActualManual" name="KmActual" class="form-control form-control-solid fs-7" placeholder="0" />
                        </div>
                        <div class="col-md-4 fv-row">
                            <label class="form-label fw-bold text-muted fs-7">Kms. Recorridos</label>
                            <input type="number" id="txtRecorridosManual" name="KmRecorridos" class="form-control form-control-solid fs-7 bg-light text-dark" readonly />
                        </div>
                    </div>


                    <div class="mb-7">
                        <label class="required fw-semibold fs-6 mb-2">Tipo de Combustible</label>
                        <select name="IdComb" class="form-select form-select-solid" required>
                            <option value="">Seleccione...</option>
                            @foreach (var tipo in ViewBag.TiposCombustible)
                            {
                                <option value="@tipo.IdComb">@tipo.Nombre</option>
                            }
                        </select>
                    </div>



                    <div class="row g-9">
                        <div class="col-md-3 fv-row">
                            <label class="required form-label fw-bold text-dark fs-7">Importe ($)</label>
                            <input type="number" step="0.01" id="txtImporteManual" name="Importe" class="form-control form-control-solid fs-7" placeholder="0.00" />
                        </div>
                        <div class="col-md-3 fv-row">
                            <label class="required form-label fw-bold text-dark fs-7">Litros</label>
                            <input type="number" step="0.01" id="txtLitrosManual" name="Litros" class="form-control form-control-solid fs-7" placeholder="0.00" />
                        </div>
                        <div class="col-md-3 fv-row">
                            <label class="required form-label fw-bold text-dark fs-7">Costo x Lt.</label>
                            <input type="number" id="txtCostoLtManual" name="CostoXLt" class="form-control form-control-solid fs-7" placeholder="0.00" />
                        </div>
                        <div class="col-md-3 fv-row">
                            <label class="form-label fw-bold text-muted fs-7">Km. x Lt. (Rendimiento)</label>
                            <input type="text" id="txtRendimientoManual" name="Rendimiento" class="form-control form-control-solid fs-7 bg-light text-dark" readonly />
                        </div>
                        
                    </div>

                    <div class="row g-9">
                        <div class="col-md-12">
                            <div class="form-check form-check-custom form-check-solid">
                                <input class="form-check-input" type="checkbox" name="Traspasar" value="1" id="chkTraspasarManual" />
                                <label class="form-check-label fw-bold text-dark fs-7" for="chkTraspasarManual">
                                    Marcar para Traspasar de inmediato
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end pt-5">
                        <button type="submit" id="kt_cargas_in_submit" class="btn btn-primary">
                            <span class="indicator-label">Guardar Carga Manual</span>
                            <span class="indicator-progress">
                                Guardando en base de datos... <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                            </span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/administrativo/cargasTransitorias/add.js" asp-append-version="true"></script>
}