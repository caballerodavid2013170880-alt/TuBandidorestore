@using SUVAN.BackOffice.Models.ViewModel.Administrativo;
@using SUVAN.BackOffice.Models.ViewModel.Enums;
@using SUVAN.BackOffice.Portal.Helper;
@inject IUsuarioHelper UsuarioHelper
@model LlantaModeloViewModel

@{
    var esEdicion = Model.IdModeloLlanta > 0;
    var titulo = esEdicion ? "Editar modelo de llanta" : "Agregar modelo de llanta";
    var accionFormulario = esEdicion ? "Editar" : "Crear";
    ViewData["Title"] = titulo;
}

@{
    var permisosPagina = await UsuarioHelper.GetPermisosPagina(User, EnumOpcionMenu.LlantasModelo);
    if (permisosPagina == null)
    {
        return;
    }
}

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar ">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                <a asp-controller="LlantasModelo" asp-action="Index" class="page-heading d-flex justify-content-center align-center text-dark fw-bold fs-3 m-0 ">
                    <i class="ki-duotone ki-left fs-1 pe-5"></i>
                    <span>@titulo</span>
                </a>
            </div>
        </div>
    </div>
</div>
<!--end::Toolbar-->

<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">
        <div class="card">
            <div class="card-body py-4">
                <form class="form w-100" novalidate="novalidate" id="kt_llantamodelo_in_form" action="@Url.Action(accionFormulario, "LlantasModelo", esEdicion ? new { id = Model.IdModeloLlanta } : null)" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="IdModeloLlanta" type="hidden" />
                    <div class="fv-row mb-8">
                        <div class="col-sm-12">
                            <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                <div asp-validation-summary="All"></div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-6">
                            <div class="fv-row mb-3">
                                <label asp-for="IdMarcaLlanta" class="col-form-label text-gray-600 required">Marca</label>
                                <select asp-for="IdMarcaLlanta" id="IdMarcaLlanta" class="form-select bg-transparent" data-control="select2" data-placeholder="Seleccione una marca">
                                    <option value="">Seleccione una marca</option>
                                    @foreach (var marca in Model.Marcas)
                                    {
                                        <option value="@marca.Id">@marca.Nombre</option>
                                    }
                                </select>
                                <span asp-validation-for="IdMarcaLlanta" class="invalid-feedback"></span>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="fv-row mb-3">
                                <label asp-for="Nombre" class="col-form-label text-gray-600 required">Modelo</label>
                                <input asp-for="Nombre" class="form-control bg-transparent" placeholder="Modelo" maxlength="150" autocomplete="off" />
                                <span asp-validation-for="Nombre" class="invalid-feedback"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-4">
                            <div class="fv-row mb-3">
                                <label asp-for="Medida" class="col-form-label text-gray-600">Medida</label>
                                <input asp-for="Medida" class="form-control bg-transparent" placeholder="Medida" maxlength="50" autocomplete="off" />
                                <span asp-validation-for="Medida" class="invalid-feedback"></span>
                            </div>
                        </div>

                        <div class="col-sm-4">
                            <div class="fv-row mb-3">
                                <label asp-for="PresionMinimaPsi" class="col-form-label text-gray-600">Presión mínima PSI</label>
                                <input asp-for="PresionMinimaPsi" type="number" class="form-control bg-transparent" placeholder="0.00" min="0" max="999.99" step="0.01" />
                                <span asp-validation-for="PresionMinimaPsi" class="invalid-feedback"></span>
                            </div>
                        </div>

                        <div class="col-sm-4">
                            <div class="fv-row mb-3">
                                <label asp-for="PresionMaximaPsi" class="col-form-label text-gray-600">Presión máxima PSI</label>
                                <input asp-for="PresionMaximaPsi" type="number" class="form-control bg-transparent" placeholder="0.00" min="0" max="999.99" step="0.01" />
                                <span asp-validation-for="PresionMaximaPsi" class="invalid-feedback"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-4">
                            <div class="fv-row mb-3">
                                <label asp-for="ProfundidadOriginalMm" class="col-form-label text-gray-600">Profundidad original mm</label>
                                <input asp-for="ProfundidadOriginalMm" type="number" class="form-control bg-transparent" placeholder="0.00" min="0" max="999.99" step="0.01" />
                                <span asp-validation-for="ProfundidadOriginalMm" class="invalid-feedback"></span>
                            </div>
                        </div>

                        <div class="col-sm-4">
                            <div class="fv-row mb-3">
                                <label asp-for="VidaUtilEstimadaKm" class="col-form-label text-gray-600">Vida útil estimada km</label>
                                <input asp-for="VidaUtilEstimadaKm" type="number" class="form-control bg-transparent" placeholder="0" min="0" step="1" />
                                <span asp-validation-for="VidaUtilEstimadaKm" class="invalid-feedback"></span>
                            </div>
                        </div>
                    </div>

                    <div class="text-end">
                        <a asp-controller="LlantasModelo" asp-action="Index" class="btn btn-light btn-sm me-2">Cancelar</a>
                        <button type="submit" id="kt_llantamodelo_in_submit" class="btn btn-primary btn-sm">
                            <span class="indicator-label">Guardar</span>
                            <span class="indicator-progress">
                                Por favor espere...
                                <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                            </span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!--end::Content-->

@section Scripts {
    <script src="~/js/administrativo/llantasmodelo/add.js" asp-append-version="true"></script>
    <script src="~/assets/js/widgets.bundle.js"></script>
    <script src="~/assets/js/custom/widgets.js"></script>
}
