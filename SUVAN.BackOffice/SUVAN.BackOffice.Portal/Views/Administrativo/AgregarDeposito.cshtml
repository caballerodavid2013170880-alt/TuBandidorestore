@using SUVAN.BackOffice.Models.ViewModel.Administrativo
@using SUVAN.BackOffice.Models.ViewModel.Enums;
@using SUVAN.BackOffice.Portal.Helper;
@inject IUsuarioHelper UsuarioHelper
@{
    ViewData["Title"] = "Depósito";
}
@model DepositoViewModel
@{
    var permisosPagina = await UsuarioHelper.GetPermisosPagina(User, EnumOpcionMenu.empresas);
    if (permisosPagina == null)
    {
        return;
    }
    var isAgregarText = Model.IdDeposito == 0 ? "Agregar" : "Editar";
    var isEdicion = Model.IdDeposito > 0;
}
<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar ">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                <a href="~/Administrativo/Depositos" class="page-heading d-flex justify-content-center align-center text-dark fw-bold fs-3 m-0">
                    <i class="ki-duotone ki-left fs-1 pe-5"></i>
                    <span>@isAgregarText @ViewData["Title"]</span>
                </a>
            </div>
        </div>
    </div>
</div>
<!--end::Toolbar-->
<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">
        <div class="card">
            <div class="card-body py-4">
                <form class="form w-100" novalidate="novalidate" id="kt_deposito_in_form"
                      asp-controller="Administrativo" asp-action="AgregarDeposito" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="IdDeposito" type="hidden" />
                    <input asp-for="IdEmpresa" type="hidden" value="@User.GetEmpresaId()" />

                    <div class="fv-row mb-8">
                        <div class="col-sm-12">
                            <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                <div asp-validation-summary="All"></div>
                            </div>
                        </div>
                    </div>

                    <!--begin::Fila 1 — Región, Planta y Zona-->
                    <div class="row">
                        <!--Región-->
                        <div class="col-sm-4">
                            <div class="fv-row mb-8">
                                <label asp-for="IdRegion" class="col-form-label text-gray-600 required">Región</label>
                                @if (isEdicion)
                                {
                                    <select id="selectIdRegion" name="IdRegion_display" class="form-select bg-transparent" disabled>
                                        <option value="">-- Seleccione una Región --</option>
                                        @foreach (var region in Model.Regiones)
                                        {
                                            <option value="@region.Id" selected="@(region.Id == Model.IdRegion ? "selected" : null)">@region.Nombre</option>
                                        }
                                    </select>
                                    <input type="hidden" asp-for="IdRegion" />
                                }
                                else
                                {
                                    <select id="selectIdRegion" name="IdRegion" class="form-select bg-transparent">
                                        <option value="0">-- Seleccione una Región --</option>
                                        @foreach (var region in Model.Regiones)
                                        {
                                            <option value="@region.Id">@region.Nombre</option>
                                        }
                                    </select>
                                }
                                <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                    <span asp-validation-for="IdRegion"></span>
                                </div>
                            </div>
                        </div>

                        <!--Planta-->
                        <div class="col-sm-4">
                            <div class="fv-row mb-8">
                                <label asp-for="IdPlanta" class="col-form-label text-gray-600 required">Planta</label>
                                @if (isEdicion)
                                {
                                    <select id="selectIdPlanta" name="IdPlanta_display" class="form-select bg-transparent" disabled>
                                        <option value="">-- Seleccione una Planta --</option>
                                        @foreach (var planta in Model.Plantas)
                                        {
                                            <option value="@planta.Id" selected="@(planta.Id == Model.IdPlanta ? "selected" : null)">@planta.Nombre</option>
                                        }
                                    </select>
                                    <input type="hidden" asp-for="IdPlanta" />
                                }
                                else
                                {
                                    <select id="selectIdPlanta" name="IdPlanta" class="form-select bg-transparent" disabled>
                                        <option value="0">-- Primero seleccione una Región --</option>
                                    </select>
                                }
                                <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                    <span asp-validation-for="IdPlanta"></span>
                                </div>
                            </div>
                        </div>

                        <!--Zona-->
                        <div class="col-sm-4">
                            <div class="fv-row mb-8">
                                <label asp-for="IdZona" class="col-form-label text-gray-600 required">Zona</label>
                                @if (isEdicion)
                                {
                                    <select id="selectIdZona" name="IdZona_display" class="form-select bg-transparent" disabled>
                                        <option value="">-- Seleccione una Zona --</option>
                                        @foreach (var zona in Model.Zonas)
                                        {
                                            <option value="@zona.Id" selected="@(zona.Id == Model.IdZona ? "selected" : null)">@zona.Nombre</option>
                                        }
                                    </select>
                                    <input type="hidden" asp-for="IdZona" />
                                }
                                else
                                {
                                    <select id="selectIdZona" name="IdZona" class="form-select bg-transparent" disabled>
                                        <option value="0">-- Primero seleccione una Planta --</option>
                                    </select>
                                }
                                <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                    <span asp-validation-for="IdZona"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--end::Fila 1-->

                    <div class="row">
                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="NombreDeposito" class="col-form-label text-gray-600 required">Nombre</label>
                                <input asp-for="NombreDeposito" class="form-control bg-transparent" placeholder="Nombre" maxlength="80" />
                                <div class="fv-plugins-message-container invalid-feedback"><span asp-validation-for="NombreDeposito"></span></div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="NomCorto" class="col-form-label text-gray-600 required">Nombre Corto</label>
                                <input asp-for="NomCorto" class="form-control bg-transparent" placeholder="Nombre Corto" />
                                <div class="fv-plugins-message-container invalid-feedback"><span asp-validation-for="NomCorto"></span></div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="Direc" class="col-form-label text-gray-600 required">Dirección</label>
                                <input asp-for="Direc" class="form-control bg-transparent" placeholder="Dirección" maxlength="250" />
                                <div class="fv-plugins-message-container invalid-feedback"><span asp-validation-for="Direc"></span></div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="Ciudad" class="col-form-label text-gray-600 required">Ciudad</label>
                                <input asp-for="Ciudad" class="form-control bg-transparent" placeholder="Ciudad" maxlength="50" />
                                <div class="fv-plugins-message-container invalid-feedback"><span asp-validation-for="Ciudad"></span></div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="Respon" class="col-form-label text-gray-600 required">Responsable</label>
                                <input asp-for="Respon" class="form-control bg-transparent" placeholder="Responsable" maxlength="100" />
                                <div class="fv-plugins-message-container invalid-feedback"><span asp-validation-for="Respon"></span></div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="RPerson" class="col-form-label text-gray-600 required">RPerson</label>
                                <input asp-for="RPerson" class="form-control bg-transparent" placeholder="RPerson" />
                                <div class="fv-plugins-message-container invalid-feedback"><span asp-validation-for="RPerson"></span></div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-4">
                            <div class="fv-row mb-8">
                                <label asp-for="Tel" class="col-form-label text-gray-600 required">Teléfono</label>
                                <input asp-for="Tel" class="form-control bg-transparent" placeholder="Teléfono" maxlength="12" />
                                <div class="fv-plugins-message-container invalid-feedback"><span asp-validation-for="Tel"></span></div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="fv-row mb-8">
                                <label asp-for="Rfc" class="col-form-label text-gray-600 required">RFC</label>
                                <input asp-for="Rfc" class="form-control bg-transparent" placeholder="RFC" />
                                <div class="fv-plugins-message-container invalid-feedback"><span asp-validation-for="Rfc"></span></div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="fv-row mb-8">
                                <label asp-for="Cp" class="col-form-label text-gray-600 required">Código Postal</label>
                                <input asp-for="Cp" class="form-control bg-transparent" placeholder="Código Postal" />
                                <div class="fv-plugins-message-container invalid-feedback"><span asp-validation-for="Cp"></span></div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="LocFor" class="col-form-label text-gray-600 required">Local/Foráneo (L o F)</label>
                                <input asp-for="LocFor" class="form-control bg-transparent" placeholder="L o F" maxlength="1" />
                                <div class="fv-plugins-message-container invalid-feedback"><span asp-validation-for="LocFor"></span></div>
                            </div>
                        </div>
                        <div class="col-sm-6 d-flex align-items-center">
                            <div class="form-check mt-5">
                                <input asp-for="ActivoBool" class="form-check-input" id="checkActivoBool" />
                                <label asp-for="ActivoBool" class="form-check-label">Activo</label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-10 text-end">
                        <button type="submit" id="kt_deposito_in_submit" class="btn btn-primary">
                            <span class="indicator-label">Guardar</span>
                            <span class="indicator-progress">
                                Por favor espere...
                                <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                            </span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!--end::Content-->
@section scripts {
    <script src="~/assets/js/widgets.bundle.js"></script>
    <script src="~/assets/js/custom/widgets.js"></script>
    <script src="~/js/administrativo/depositos/add.js" asp-append-version="true"></script>
}