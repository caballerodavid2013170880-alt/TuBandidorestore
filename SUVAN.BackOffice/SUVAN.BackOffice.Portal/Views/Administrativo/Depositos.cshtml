@using SUVAN.BackOffice.Models.ViewModel.Enums;
@using SUVAN.BackOffice.Portal.Helper;
@inject IUsuarioHelper UsuarioHelper
@{
    ViewData["Title"] = "Depósitos";
}
@model List<SUVAN.BackOffice.Database.Entities.Deposito>
@{
    var permisosPagina = await UsuarioHelper.GetPermisosPagina(User, EnumOpcionMenu.empresas);
    if (permisosPagina == null)
    {
        return;
    }
}
<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar ">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                <h1 class="page-heading d-flex flex-column justify-content-center text-dark fw-bold fs-3 m-0">@ViewData["Title"]</h1>
            </div>
            <div class="d-flex align-items-center gap-2 gap-lg-3">
                @if (permisosPagina!.Agregar)
                {
                    <a href="~/Administrativo/AgregarDeposito" class="btn btn-flex btn-outline btn-color-gray-700 btn-active-color-primary bg-body h-40px fs-7 fw-bold">Agregar Depósito</a>
                }
            </div>
        </div>
    </div>
</div>
<!--end::Toolbar-->
<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">
        <div class="card">
            <div class="card-header border-0 pt-6">
                <div class="card-title">
                    <div class="d-flex align-items-center position-relative my-1">
                        <i class="ki-outline ki-magnifier fs-3 position-absolute ms-5"></i>
                        <input type="text" data-kt-deposito-table-filter="search" class="form-control form-control-solid w-450px ps-13" placeholder="Buscar depósito..." />
                    </div>
                </div>
            </div>
            <div class="card-body py-4">
                @Html.AntiForgeryToken()
                <table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_table_deposito">
                    <thead>
                        <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                            <th class="min-w-150px">Zona</th>
                            <th class="min-w-200px">Depósito</th>
                            <th class="min-w-150px">Responsable</th>
                            <th class="min-w-100px">Estatus</th>
                            <th class="text-end min-w-100px">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="text-gray-600 fw-semibold">
                        @foreach (var dep in Model)
                        {
                            <tr>
                                <td>@dep.IdZonaNavigation?.NombreZona</td>
                                <td>@dep.NombreDeposito</td>
                                <td>@dep.Respon</td>
                                <td>
                                    @{
                                        var activo = dep.Activo == 1 ? "Activo" : "Inactivo";
                                        var badgeClass = dep.Activo == 1 ? "badge-light-success" : "badge-light-danger";
                                    }
                                    <span class="badge @badgeClass">@activo</span>
                                </td>
                                <td class="text-end">
                                    @if (permisosPagina!.Editar)
                                    {
                                        <a href="~/Administrativo/AgregarDeposito/@dep.IdDeposito"
                                           class="btn btn-icon btn-active-light-primary w-30px h-30px"
                                           title="Editar depósito">
                                            <i class="ki-outline ki-pencil fs-3"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<!--end::Content-->
@section scripts {
    <script src="~/js/administrativo/depositos/table.js" asp-append-version="true"></script>
    <script src="~/assets/js/widgets.bundle.js"></script>
    <script src="~/assets/js/custom/widgets.js"></script>
}