@{
  Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
  <base href="/" />
  <title>Solución Flotillas | Inicio de sesión</title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="shortcut icon" href="~/assets/media/logos/favicon.ico" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:300,400,500,600,700" />
  <link href="~/assets/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" />
  <link href="~/assets/css/style.bundle.css" rel="stylesheet" type="text/css" asp-append-version="true" />
  <link href="~/css/site.css" rel="stylesheet" type="text/css" asp-append-version="true" />
  <link href="~/css/login.css" rel="stylesheet" type="text/css" asp-append-version="true" />
</head>
<body id="kt_body" class="app-blank login-page">
  <script>var defaultThemeMode = "light"; var themeMode; if (document.documentElement) { if (document.documentElement.hasAttribute("data-bs-theme-mode")) { themeMode = document.documentElement.getAttribute("data-bs-theme-mode"); } else { if (localStorage.getItem("data-bs-theme") !== null) { themeMode = localStorage.getItem("data-bs-theme"); } else { themeMode = defaultThemeMode; } } if (themeMode === "system") { themeMode = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"; } document.documentElement.setAttribute("data-bs-theme", themeMode); }</script>

  <main class="suvan-login" id="kt_app_root">
    <section class="suvan-login__panel suvan-login__panel--form" aria-labelledby="login-title">
      <img class="suvan-login__decoration" src="~/images/login/login-decoration-left.png" alt="" aria-hidden="true" />
      <div class="suvan-login__form-area">
        <div class="suvan-login__form-wrapper">
          <a class="suvan-login__brand" href="/" aria-label="Solución Flotillas">
            <img src="~/images/login/logo_login.png" alt="Solución Flotillas" />
          </a>
          <div class="suvan-login__heading">
            <h1 id="login-title">Inicio de sesión</h1>
            <p>Para usuarios administradores</p>
          </div>

          <form class="form w-100 suvan-login__form" novalidate="novalidate" id="kt_sign_in_form" data-kt-redirect-url="/" method="post" enctype="multipart/form-data" asp-controller="Seguridad" asp-action="Login">
            @Html.AntiForgeryToken()
            <div class="fv-row suvan-login__field">
              <label class="suvan-login__field-label" for="login-email">Correo electrónico</label>
              <div class="suvan-login__input-wrap">
                <i class="ki-outline ki-sms suvan-login__field-icon" aria-hidden="true"></i>
                <input id="login-email" type="text" placeholder="Correo electrónico" name="email" autocomplete="username" class="form-control bg-transparent" />
              </div>
            </div>
            <div class="fv-row suvan-login__field">
              <label class="suvan-login__field-label" for="login-password">Contraseña</label>
              <div class="suvan-login__input-wrap">
                <i class="ki-outline ki-lock-2 suvan-login__field-icon" aria-hidden="true"></i>
                <input id="login-password" type="password" placeholder="Contraseña" name="password" autocomplete="current-password" class="form-control bg-transparent" />
              </div>
            </div>
            <div class="suvan-login__password-row">
              <a href="~/seguridad/olvido">¿Olvidaste tu contraseña?</a>
            </div>
            <div class="suvan-login__error fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback" role="alert">@ViewBag.ErrorLogin</div>
            <button type="submit" id="kt_sign_in_submit" class="btn btn-primary suvan-login__submit">
              <span class="indicator-label">Iniciar sesión</span>
              <span class="indicator-progress">Por favor espere... <span class="spinner-border spinner-border-sm align-middle ms-2"></span></span>
            </button>
          </form>
        </div>
      </div>
      <footer class="suvan-login__footer">
        <a href="/seguridad/terminoscondiciones" target="_blank">Términos y Condiciones</a>
        <span aria-hidden="true">|</span>
        <a href="/seguridad/avisodeprivacidad" target="_blank">Aviso de privacidad</a>
      </footer>
    </section>

    <section class="suvan-login__panel suvan-login__panel--benefits" aria-labelledby="benefits-title">
      <div class="suvan-login__benefits-content">
        <div class="suvan-login__benefits-heading">
          <h2 id="benefits-title">La mejor experiencia a<br />precios justos y accesibles</h2>
          <p>Van's con asientos confortables, y con socios conductores capacitados y listos para llevarte a tu destino a tiempo.</p>
        </div>
        <div class="suvan-login__benefits-list">
          <div class="suvan-login__passenger"><img src="~/images/login/icon-passenger.png" alt="" aria-hidden="true" /></div>
          <div class="suvan-login__benefit-items">
            <div class="suvan-login__benefit"><img src="~/images/login/icon-shield.png" alt="" aria-hidden="true" /><span>Viajes seguros</span></div>
            <div class="suvan-login__benefit"><img src="~/images/login/icon-drivers.png" alt="" aria-hidden="true" /><span>Conductores capacitados</span></div>
            <div class="suvan-login__benefit"><img src="~/images/login/icon-clock.png" alt="" aria-hidden="true" /><span>Siempre a tiempo</span></div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>var hostUrl = "assets/";</script>
  <script src="~/assets/plugins/global/plugins.bundle.js"></script>
  <script src="~/assets/js/scripts.bundle.js"></script>
  <script src="~/js/auth/general.js" asp-append-version="true"></script>
</body>
</html>
