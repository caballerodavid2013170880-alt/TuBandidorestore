@using SUVAN.BackOffice.Models.ViewModel.Logistica;
@model ManoObraViewModel
@{
    bool isEdicion = Model.IdManoObra > 0;
    var isAgregarText = !isEdicion ? "Agregar" : "Editar";
    ViewData["Title"] = isAgregarText + " Mano de Obra";
}
<script>
    window.SUVAN = window.SUVAN || {};
    window.SUVAN.Urls = {
        AjaxSave: '@Url.Action("AgregarManoObraAjax", "ManoObra")'
    };
</script>
<div class="app-toolbar" id="kt_app_toolbar">
    <div class="app-container container-fluid d-flex align-items-stretch">
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                <a href="~/ManoObra" class="page-heading d-flex justify-content-center align-center text-dark fw-bold fs-3 m-0 ">
                    <i class="ki-duotone ki-left fs-1 pe-5"></i>
                    <span>@ViewData["Title"]</span>
                </a>
            </div>
        </div>
    </div>
</div>
<div class="app-content flex-column-fluid">
    <div class="app-container container-fluid">
        <form class="form w-100" novalidate="novalidate" id="form_agregar_manoobra">
            @Html.AntiForgeryToken()
            <input asp-for="IdManoObra" type="hidden" />
            <div class="card mb-5 mb-xl-10">
                <div class="card-header border-0 cursor-pointer">
                    <div class="card-title m-0">
                        <h3 class="fw-bold m-0">Datos Generales</h3>
                    </div>
                </div>
                <div class="card-body py-4">
                    <div class="row">
                        <div class="col-sm-6 mb-8">
                            <label class="required col-form-label">Descripción del Servicio</label>
                            <input asp-for="DescripcionManoobra" class="form-control" />
                        </div>
                        <div class="col-sm-6 mb-8">
                            <label class="required col-form-label">Costo Unitario</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="CostoUnitario" type="number" step="0.01" min="0" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card mb-5 mb-xl-10">
                <div class="card-header border-0 cursor-pointer d-flex justify-content-between align-items-center">
                    <div class="card-title m-0">
                        <h3 class="fw-bold m-0">Actividades</h3>
                    </div>
                    <button type="button" id="btnAgregarActividad" class="btn btn-sm btn-light-primary">
                        <i class="ki-outline ki-plus fs-2"></i> Agregar Actividad
                    </button>
                </div>
                <div class="card-body py-4">
                    <div class="table-responsive">
                        <table class="table align-middle table-row-dashed fs-6 gy-5" id="tablaActividades">
                            <thead>
                                <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                                    <th class="min-w-300px">Descripción de la Actividad</th>
                                    <th class="min-w-100px text-center">Obligatoria</th>
                                    <th class="text-end min-w-100px">Acciones</th>
                                </tr>
                            </thead>
                            <tbody class="text-gray-600 fw-semibold" id="tbodyActividades">
                                @if (Model.Detalles != null && Model.Detalles.Any())
                                {
                                    var index = 0;
                                    foreach (var det in Model.Detalles)
                                    {
                                        <tr data-index="@index" class="actividad-row">
                                            <td>
                                                <input type="hidden" name="Detalles[@index].IdMoDetalle" value="@det.IdMoDetalle" class="id-detalle" />
                                                <input type="hidden" name="Detalles[@index].IdManoObra" value="@det.IdManoObra" />
                                                <input type="text" name="Detalles[@index].DescripcionActividad" class="form-control" value="@det.DescripcionActividad" />
                                            </td>
                                            <td class="text-center">
                                                <div class="form-check form-switch form-check-custom form-check-solid d-flex justify-content-center">
                                                    <input class="form-check-input h-20px w-30px" type="checkbox" name="Detalles[@index].EsObligatorio" value="true" @(det.EsObligatorio ? "checked" : "") />
                                                    <input type="hidden" name="Detalles[@index].EsObligatorio" value="false" />
                                                </div>
                                            </td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-icon btn-active-light-danger w-30px h-30px btnEliminarActividad">
                                                    <i class="ki-outline ki-trash fs-3"></i>
                                                </button>
                                            </td>
                                        </tr>
                                        index++;
                                    }
                                }
                                else
                                {
                                    <tr id="trEmpty">
                                        <td colspan="3" class="text-center text-muted">No hay actividades registradas. Haga clic en "Agregar Actividad" para comenzar.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="text-end mt-8">
                        <a href="~/ManoObra/Index" class="btn btn-light me-3">Cancelar</a>
                        <button type="submit" id="btn_guardar" class="btn btn-primary">
                            <span class="indicator-label">Guardar Registro</span>
                            <span class="indicator-progress">
                                Por favor espere...
                                <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                            </span>
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
@section scripts {
    <script src="~/js/logistica/manoobra/add.js" asp-append-version="true"></script>
}