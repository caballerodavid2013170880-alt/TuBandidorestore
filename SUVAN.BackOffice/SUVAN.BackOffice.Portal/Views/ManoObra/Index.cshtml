@using SUVAN.BackOffice.Models.ViewModel.Enums;
@using SUVAN.BackOffice.Portal.Helper;
@inject IUsuarioHelper UsuarioHelper
@{
    ViewData["Title"] = "Consulta de Mano de Obra";
}
@model List<SUVAN.BackOffice.Models.ViewModel.Logistica.ManoObraViewModel>
@{
    var permisosPagina = await UsuarioHelper.GetPermisosPagina(User, EnumOpcionMenu.ManoObra);
    if (permisosPagina == null) { return; }
}
<div id="kt_app_toolbar" class="app-toolbar">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                <h1 class="page-heading d-flex flex-column justify-content-center text-dark fw-bold fs-3 m-0">@ViewData["Title"]</h1>
            </div>
            <div class="d-flex align-items-center gap-2 gap-lg-3">
                @if (permisosPagina!.Agregar)
                {
                    <a href="@Url.Action("AgregarManoObra", "ManoObra")" class="btn btn-flex btn-outline btn-color-gray-700 btn-active-color-primary bg-body h-40px fs-7 fw-bold">Agregar Mano de Obra</a>
                }
            </div>
        </div>
    </div>
</div>
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">
        <div class="d-flex align-items-center mb-8 overflow-auto">
            <a href="@Url.Action("Index", "ManoObra")" class="btn btn-primary me-3">Servicios (Mano de obra)</a>
            <a href="@Url.Action("DetalleManoObras", "ManoObra")" class="btn btn-light btn-active-primary">Detalle de Mano de Obra</a>
        </div>
        <div class="card">
            <div class="card-header border-0 pt-6 d-flex flex-column">
                <div class="row g-4 w-100 mb-4">
                    <div class="col-md-6">
                        <div class="d-flex align-items-center position-relative my-1">
                            <i class="ki-outline ki-magnifier fs-3 position-absolute ms-5"></i>
                            <input type="text" id="filtroGeneralManoObra" class="form-control form-control-solid ps-13" placeholder="Buscar texto general..." />
                        </div>
                    </div>
                </div>
                <div class="row g-4 w-100 border-top pt-4">
                    <div class="col-md-12">
                        <label class="form-label fs-7 fw-bold text-gray-700 mb-2">Ordenar Por:</label>
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <select id="sortNombre" class="form-select form-select-sm form-select-solid w-150px sort-filter">
                                <option value="">Nombre</option>
                                <option value="asc">Ascendente</option>
                                <option value="desc">Descendente</option>
                            </select>
                            <select id="sortCosto" class="form-select form-select-sm form-select-solid w-150px sort-filter">
                                <option value="">Costo Unitario</option>
                                <option value="asc">Ascendente</option>
                                <option value="desc">Descendente</option>
                            </select>
                            <button type="button" id="btnLimpiarOrden" class="btn btn-sm btn-light">Limpiar Filtros</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body py-4">
                <div class="table-responsive">
                    <table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_table_manoobra">
                        <thead>
                            <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                                <th>Descripción</th>
                                <th>Costo Unitario</th>
                                <th class="text-end min-w-100px">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="text-gray-600 fw-semibold">
                            @foreach (var mo in Model)
                            {
                                <tr>
                                    <td>@mo.DescripcionManoobra</td>
                                    <td data-sort="@(mo.CostoUnitario ?? 0)"><span class="badge badge-light-success">@((mo.CostoUnitario ?? 0).ToString("C"))</span></td>
                                    <td class="text-end">
                                        <button class="btn btn-icon btn-active-light-primary w-30px h-30px me-1" onclick="abrirModalDetalle(@mo.IdManoObra)" title="Ver actividades asociadas">
                                            <i class="ki-outline ki-eye fs-3"></i>
                                        </button>
                                        @if (permisosPagina!.Editar)
                                        {
                                            <a href="@Url.Action("AgregarManoObra", "ManoObra", new { id = mo.IdManoObra })" class="btn btn-icon btn-active-light-primary w-30px h-30px" title="Editar mano de obra">
                                                <i class="ki-outline ki-pencil fs-3"></i>
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" tabindex="-1" id="modalDetalleManoObra">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content" id="modalContentAjax">
        </div>
    </div>
</div>
@section scripts {
    <script src="~/js/logistica/manoobra/table.js" asp-append-version="true"></script>
}
