@using SUVAN.BackOffice.Models.ViewModel.Enums;
@using SUVAN.BackOffice.Portal.Helper;
@inject IUsuarioHelper UsuarioHelper
@{
    ViewData["Title"] = "Departamentos";
}
@model List<SUVAN.BackOffice.Database.Entities.Depto>
@{
    var permisosPagina = await UsuarioHelper.GetPermisosPagina(User, EnumOpcionMenu.Departamentos);
    if (permisosPagina == null)
    {
        return;
    }
}
<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar ">
    <!--begin::Toolbar container-->
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
        <!--begin::Toolbar wrapper-->
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <!--begin::Page title-->
            <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                <!--begin::Title-->
                <h1 class="page-heading d-flex flex-column justify-content-center text-dark fw-bold fs-3 m-0">@ViewData["Title"]</h1>
                <!--end::Title-->
            </div>
            <!--end::Page title-->
            <!--begin::Actions-->
            <div class="d-flex align-items-center gap-2 gap-lg-3">
                @if (permisosPagina!.Agregar)
                {
                    <a href="~/configuracion/agregardepto"
                       class="btn btn-flex btn-outline btn-color-gray-700 btn-active-color-primary bg-body h-40px fs-7 fw-bold">
                        Agregar Departamento
                    </a>
                }
            </div>
            <!--end::Actions-->
        </div>
        <!--end::Toolbar wrapper-->
    </div>
    <!--end::Toolbar container-->
</div>
<!--end::Toolbar-->
<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <!--begin::Content container-->
    <div id="kt_app_content_container" class="app-container container-fluid">
        <!--begin::Card-->
        <div class="card">
            <!--begin::Card header-->
            <div class="card-header border-0 pt-6">
                <!--begin::Card title-->
                <div class="card-title">
                    <!--begin::Search-->
                    <div class="d-flex align-items-center position-relative my-1">
                        <i class="ki-outline ki-magnifier fs-3 position-absolute ms-5"></i>
                        <input type="text"
                               id="buscarDepto"
                               data-kt-depto-table-filter="search"
                               class="form-control form-control-solid w-450px ps-13"
                               placeholder="Buscar departamento..." />
                    </div>
                    <!--end::Search-->
                </div>
                <!--end::Card title-->
            </div>
            <!--end::Card header-->
            <!--begin::Card body-->
            <div class="card-body py-4">
                <!--TempData: leído por table.js para mostrar SweetAlert de confirmación-->
                <input type="hidden" id="mensajeTempData" value="@TempData["Mensaje"]" />
                <!--Token CSRF: utilizado por table.js al eliminar vía fetch POST-->
                @Html.AntiForgeryToken()
                <!--begin::Table-->
                <table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_table_depto">
                    <thead>
                        <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                            <!--Columna Depósito: nombre del depósito al que pertenece el depto (eager-loaded)-->
                            <th class="min-w-150px">Depósito</th>
                            <!--Columna Departamento: nombre del departamento-->
                            <th class="min-w-200px">Departamento</th>
                            <!--Columna Responsable-->
                            <th class="min-w-150px">Responsable</th>
                            <!--Columna Estatus: badge Activo/Inactivo-->
                            <th class="min-w-100px">Estatus</th>
                            <!--Columna Acciones: editar y eliminar según permisos-->
                            <th class="text-end min-w-100px">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="text-gray-600 fw-semibold">
                        @foreach (var depto in Model)
                        {
                            <tr>
                                <!--Depósito: se carga vía Include(d => d.IdDepositoNavigation) en DeptoService.GetDeptos-->
                                <td>@depto.IdDepositoNavigation?.NombreDeposito</td>
                                <!--Nombre del departamento-->
                                <td>@depto.NombreDepto</td>
                                <!--Responsable del departamento-->
                                <td>@depto.Responsable</td>
                                <!--Estatus: badge verde = Activo, rojo = Inactivo-->
                                <td>
                                    @{
                                        var activo = depto.Activo == 1 ? "Activo" : "Inactivo";
                                        var badgeClass = depto.Activo == 1 ? "badge-light-success" : "badge-light-danger";
                                    }
                                    <span class="badge @badgeClass">@activo</span>
                                </td>
                                <!--Acciones: editar/eliminar según permisos del perfil-->
                                <td class="text-end">
                                    @if (permisosPagina!.Editar)
                                    {
                                        <a href="~/configuracion/agregardepto/@depto.IdDepto"
                                           class="btn btn-icon btn-active-light-primary w-30px h-30px"
                                           title="Editar departamento">
                                            <i class="ki-outline ki-pencil fs-3"></i>
                                        </a>
                                    }
                                    @if (permisosPagina!.Eliminar)
                                    {
                                        <button type="button"
                                                id="btnEliminar_@depto.IdDepto"
                                                class="btn btn-icon btn-active-light-danger w-30px h-30px btn-eliminar-depto"
                                                data-id="@depto.IdDepto"
                                                data-nombre="@depto.NombreDepto"
                                                title="Eliminar departamento">
                                            <i class="ki-outline ki-trash fs-3"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <!--end::Table-->
            </div>
            <!--end::Card body-->
        </div>
        <!--end::Card-->
    </div>
    <!--end::Content container-->
</div>
<!--end::Content-->
<!--begin::Modal de confirmación de eliminación (patrón Planta)-->
<div class="modal fade" id="kt_modal_eliminar_depto" tabindex="-1" aria-labelledby="kt_modal_eliminar_depto_label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content">
            <!--begin::Modal header-->
            <div class="modal-header">
                <h2 class="fw-bold" id="kt_modal_eliminar_depto_label">Eliminar Departamento</h2>
                <div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal" aria-label="Cerrar">
                    <i class="ki-outline ki-cross fs-1"></i>
                </div>
            </div>
            <!--end::Modal header-->
            <!--begin::Modal body-->
            <div class="modal-body py-5 px-lg-10">
                <p class="fs-6 fw-semibold text-gray-700">
                    ¿Está seguro de que desea eliminar el departamento <strong id="modal_depto_nombre"></strong>?<br />
                    Esta acción no se puede deshacer.
                </p>
            </div>
            <!--end::Modal body-->
            <!--begin::Modal footer-->
            <div class="modal-footer flex-center">
                <button type="button" id="btnCancelarEliminar" class="btn btn-light me-3" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btnConfirmarEliminar" class="btn btn-danger">
                    <span class="indicator-label">Sí, eliminar</span>
                    <span class="indicator-progress">
                        Eliminando...
                        <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                    </span>
                </button>
            </div>
            <!--end::Modal footer-->
        </div>
    </div>
</div>
<!--end::Modal de confirmación de eliminación-->
@section scripts {
    <script src="~/js/configuracion/depto/table.js" asp-append-version="true"></script>
    <script src="~/assets/js/widgets.bundle.js"></script>
    <script src="~/assets/js/custom/widgets.js"></script>
}
