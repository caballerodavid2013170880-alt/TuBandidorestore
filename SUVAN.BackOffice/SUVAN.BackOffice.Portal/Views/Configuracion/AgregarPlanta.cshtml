@using SUVAN.BackOffice.Models.Facturacion
@using SUVAN.BackOffice.Models.ViewModel;
@using SUVAN.BackOffice.Models.ViewModel.Enums;
@using SUVAN.BackOffice.Portal.Helper;
@inject IUsuarioHelper UsuarioHelper
@{
    ViewData["Title"] = "PLanta";
}

@model PlantaViewModel
@{
    var permisosPagina = await UsuarioHelper.GetPermisosPagina(User, EnumOpcionMenu.empresas);
    if (permisosPagina == null)
    {
        return;
    }
    var isAgregarText = Model.IdPlanta == 0 ? "Agregar" : "Editar";
    var isEdicion = Model.IdPlanta > 0;
}
<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar ">
    <!--begin::Toolbar container-->
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
        <!--begin::Toolbar wrapper-->
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <!--begin::Page title-->
            <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                <!--begin::Title-->
                <a href="~/configuracion/plantas" class="page-heading d-flex justify-content-center align-center text-dark fw-bold fs-3 m-0 ">
                    <i class="ki-duotone ki-left fs-1 pe-5"></i>
                    <span>@isAgregarText @ViewData["Title"]</span>
                </a>
                <!--end::Title-->
            </div>
            <!--end::Page title-->
        </div>
        <!--end::Toolbar wrapper-->
    </div>
    <!--end::Toolbar container-->
</div>
<!--end::Toolbar-->
<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <!--begin::Content container-->
    <div id="kt_app_content_container" class="app-container container-fluid">
        <!--begin::Card-->
        <div class="card">
            <!--begin::Card body-->
            <div class="card-body py-4">
                <form class="form w-100" novalidate="novalidate" id="kt_planta_in_form"
                      asp-controller="Configuracion" asp-action="AgregarPlanta" method="post">
                    @Html.AntiForgeryToken()
                    <!--Campos ocultos: IdPlanta e IdEmpresa-->
                    <input asp-for="IdPlanta" type="hidden" />
                    <input asp-for="IdEmpresa" type="hidden" value="@User.GetEmpresaId()" />
                    <!--begin::Validation summary-->
                    <div class="fv-row mb-8">
                        <div class="col-sm-12">
                            <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                <div asp-validation-summary="All"></div>
                            </div>
                        </div>
                    </div>
                    <!--end::Validation summary-->
                    <div class="row">
                        <!--begin::Selector de Región-->
                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="IdRegion" class="col-form-label text-gray-600 required">Región</label>
                                @if (isEdicion)
                                {
                                    @* Al editar: selector visible pero deshabilitado *@
                                    <select id="IdRegion" name="IdRegion_display"
                                            class="form-select bg-transparent" disabled>
                                        <option value="">-- Seleccione una Región --</option>
                                        @foreach (var region in Model.Regiones)
                                        {
                                            <option value="@region.IdRegion"
                                                    selected="@(region.IdRegion == Model.IdRegion ? "selected" : null)">
                                                @region.Nombre
                                            </option>
                                        }
                                    </select>
                                    @* Hidden garantiza el envío del valor en POST aunque el select esté deshabilitado *@
                                    <input type="hidden" asp-for="IdRegion" />
                                }
                                else
                                {
                                    @* Al Agregar: selector habilitado y requerido *@
                                    <select asp-for="IdRegion" class="form-select bg-transparent"
                                            id="selectIdRegion">
                                        <option value="0">-- Seleccione una Región --</option>
                                        @foreach (var region in Model.Regiones)
                                        {
                                            <option value="@region.IdRegion"
                                                    selected="@(region.IdRegion == Model.IdRegion ? "selected" : null)">
                                                @region.Nombre
                                            </option>
                                        }
                                    </select>
                                }
                                <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                    <span asp-validation-for="IdRegion"></span>
                                </div>
                            </div>
                        </div>
                        <!--end::Selector de Región-->
                        <!--begin::Nombre de la Planta-->
                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="NombrePlanta" class="col-form-label text-gray-600 required">Nombre de la Planta</label>
                                <input asp-for="NombrePlanta" class="form-control bg-transparent"
                                       placeholder="Nombre de la Planta" maxlength="45" />
                                <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                    <span asp-validation-for="NombrePlanta"></span>
                                </div>
                            </div>
                        </div>
                        <!--end::Nombre de la Planta-->
                    </div>
                    <div class="row">
                        <!--begin::Librería-->
                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="Libreria" class="col-form-label text-gray-600">Librería</label>
                                <input asp-for="Libreria" class="form-control bg-transparent"
                                       placeholder="Librería (opcional)" maxlength="50" />
                                <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                    <span asp-validation-for="Libreria"></span>
                                </div>
                            </div>
                        </div>
                        <!--end::Librería-->
                        <!--begin::Activo-->
                        <div class="col-sm-3 d-flex align-items-end">
                            <div class="form-check mb-8">
                                <input asp-for="ActivoBool" class="form-check-input" id="checkActivoBool" />
                                <label asp-for="ActivoBool" class="form-check-label">Activo</label>
                            </div>
                        </div>
                        <!--end::Activo-->
                    </div>
                    <!--begin::Submit-->
                    <div class="mb-10 text-end">
                        <button type="submit" id="kt_planta_in_submit" class="btn btn-primary">
                            <!--begin::Indicator label-->
                            <span class="indicator-label">Guardar</span>
                            <!--end::Indicator label-->
                            <!--begin::Indicator progress-->
                            <span class="indicator-progress">
                                Por favor espere...
                                <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                            </span>
                            <!--end::Indicator progress-->
                        </button>
                    </div>
                    <!--end::Submit-->
                </form>
            </div>
            <!--end::Card body-->
        </div>
        <!--end::Card-->
    </div>
    <!--end::Content container-->
</div>
<!--end::Content-->
@section scripts {
    <script src="~/js/configuracion/planta/add.js" asp-append-version="true"></script>
    <script src="~/assets/js/widgets.bundle.js"></script>
    <script src="~/assets/js/custom/widgets.js"></script>
}