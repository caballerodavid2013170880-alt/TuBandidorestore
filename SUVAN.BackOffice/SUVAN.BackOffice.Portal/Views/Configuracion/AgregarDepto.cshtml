@using SUVAN.BackOffice.Models.ViewModel;
@using SUVAN.BackOffice.Models.ViewModel.Enums;
@using SUVAN.BackOffice.Portal.Helper;
@inject IUsuarioHelper UsuarioHelper
@{
    ViewData["Title"] = "Departamento";
}
@model DeptoViewModel
@{
    var permisosPagina = await UsuarioHelper.GetPermisosPagina(User, EnumOpcionMenu.Departamentos);
    if (permisosPagina == null)
    {
        return;
    }
    var isAgregarText = Model.IdDepto == 0 ? "Agregar" : "Editar";
    var isEdicion = Model.IdDepto > 0;
}
<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar ">
    <!--begin::Toolbar container-->
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
        <!--begin::Toolbar wrapper-->
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <!--begin::Page title (enlace de regreso al listado)-->
            <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                <a href="~/configuracion/depto"
                   class="page-heading d-flex justify-content-center align-center text-dark fw-bold fs-3 m-0">
                    <i class="ki-duotone ki-left fs-1 pe-5"></i>
                    <span>@isAgregarText @ViewData["Title"]</span>
                </a>
            </div>
            <!--end::Page title-->
        </div>
        <!--end::Toolbar wrapper-->
    </div>
    <!--end::Toolbar container-->
</div>
<!--end::Toolbar-->
<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <!--begin::Content container-->
    <div id="kt_app_content_container" class="app-container container-fluid">
        <!--begin::Card-->
        <div class="card">
            <!--begin::Card body-->
            <div class="card-body py-4">
                <form class="form w-100" novalidate="novalidate" id="kt_depto_in_form"
                      asp-controller="Configuracion" asp-action="AgregarDepto" method="post">
                    @Html.AntiForgeryToken()
                    <!--Campos ocultos: IdDepto e IdEmpresa-->
                    <input asp-for="IdDepto" type="hidden" />
                    <input asp-for="IdEmpresa" type="hidden" value="@User.GetEmpresaId()" />
                    @if (!isEdicion && Model.CascadeJson != null)
                    {
                        <input type="hidden" id="CascadeJson" value='@Html.Raw(Model.CascadeJson)' />
                    }
                    <!--begin::Validation summary-->
                    <div class="fv-row mb-8">
                        <div class="col-sm-12">
                            <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                <div asp-validation-summary="All"></div>
                            </div>
                        </div>
                    </div>
                    <!--end::Validation summary-->
                    <!--begin::Fila 1 — Región y Planta-->
                    <div class="row">
                        <!--begin::Selector de Región-->
                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="IdRegion" class="col-form-label text-gray-600 required">Región</label>
                                @if (isEdicion)
                                {
                                    @* Al Editar: selector visible pero deshabilitado; hidden garantiza el POST *@
                                    <select id="selectIdRegion" name="IdRegion_display"
                                            class="form-select bg-transparent" disabled>
                                        <option value="">-- Seleccione una Región --</option>
                                        @foreach (var region in Model.Regiones)
                                        {
                                            <option value="@region.IdRegion"
                                                    selected="@(region.IdRegion == Model.IdRegion ? "selected" : null)">
                                                @region.Nombre
                                            </option>
                                        }
                                    </select>
                                    <input type="hidden" asp-for="IdRegion" />
                                }
                                else
                                {
                                    @* Al Agregar: id y name explícitos (sin asp-for) para
                                       evitar que SelectTagHelper sobrescriba el id con el nombre del property *@
                                    <select id="selectIdRegion" name="IdRegion"
                                            class="form-select bg-transparent">
                                        <option value="0">-- Seleccione una Región --</option>
                                        @foreach (var region in Model.Regiones)
                                        {
                                            <option value="@region.IdRegion">@region.Nombre</option>
                                        }
                                    </select>
                                }
                                <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                    <span asp-validation-for="IdRegion"></span>
                                </div>
                            </div>
                        </div>
                        <!--end::Selector de Región-->
                        <!--begin::Selector de Planta (se habilita vía AJAX al seleccionar Región)-->
                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="IdPlanta" class="col-form-label text-gray-600 required">Planta</label>
                                @if (isEdicion)
                                {
                                    @* Al Editar: deshabilitado, pre-cargado desde servidor *@
                                    <select id="selectIdPlanta" name="IdPlanta_display"
                                            class="form-select bg-transparent" disabled>
                                        <option value="">-- Seleccione una Planta --</option>
                                        @foreach (var planta in Model.Plantas)
                                        {
                                            <option value="@planta.IdPlanta"
                                                    selected="@(planta.IdPlanta == Model.IdPlanta ? "selected" : null)">
                                                @planta.Nombre
                                            </option>
                                        }
                                    </select>
                                    <input type="hidden" asp-for="IdPlanta" />
                                }
                                else
                                {
                                    @* Al Agregar: deshabilitado hasta que se seleccione una Región *@
                                    <select id="selectIdPlanta" name="IdPlanta"
                                            class="form-select bg-transparent" disabled>
                                        <option value="0">-- Primero seleccione una Región --</option>
                                    </select>
                                }
                                <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                    <span asp-validation-for="IdPlanta"></span>
                                </div>
                            </div>
                        </div>
                        <!--end::Selector de Planta-->
                    </div>
                    <!--end::Fila 1-->
                    <!--begin::Fila 2 — Zona y Depósito-->
                    <div class="row">
                        <!--begin::Selector de Zona (se habilita vía AJAX al seleccionar Planta)-->
                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="IdZona" class="col-form-label text-gray-600 required">Zona</label>
                                @if (isEdicion)
                                {
                                    @* Al Editar: deshabilitado, pre-cargado desde servidor *@
                                    <select id="selectIdZona" name="IdZona_display"
                                            class="form-select bg-transparent" disabled>
                                        <option value="">-- Seleccione una Zona --</option>
                                        @foreach (var zona in Model.Zonas)
                                        {
                                            <option value="@zona.IdZona"
                                                    selected="@(zona.IdZona == Model.IdZona ? "selected" : null)">
                                                @zona.Nombre
                                            </option>
                                        }
                                    </select>
                                    <input type="hidden" asp-for="IdZona" />
                                }
                                else
                                {
                                    @* Al Agregar: deshabilitado hasta que se seleccione una Planta *@
                                    <select id="selectIdZona" name="IdZona"
                                            class="form-select bg-transparent" disabled>
                                        <option value="0">-- Primero seleccione una Planta --</option>
                                    </select>
                                }
                                <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                    <span asp-validation-for="IdZona"></span>
                                </div>
                            </div>
                        </div>
                        <!--end::Selector de Zona-->
                        <!--begin::Selector de Depósito (se habilita vía AJAX al seleccionar Zona)-->
                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="IdDeposito" class="col-form-label text-gray-600 required">Depósito</label>
                                @if (isEdicion)
                                {
                                    @* Al Editar: deshabilitado, pre-cargado desde servidor *@
                                    <select id="selectIdDeposito" name="IdDeposito_display"
                                            class="form-select bg-transparent" disabled>
                                        <option value="">-- Seleccione un Depósito --</option>
                                        @foreach (var dep in Model.Depositos)
                                        {
                                            <option value="@dep.IdDeposito"
                                                    selected="@(dep.IdDeposito == Model.IdDeposito ? "selected" : null)">
                                                @dep.Nombre
                                            </option>
                                        }
                                    </select>
                                    <input type="hidden" asp-for="IdDeposito" />
                                }
                                else
                                {
                                    @* Al Agregar: deshabilitado hasta que se seleccione una Zona *@
                                    <select id="selectIdDeposito" name="IdDeposito"
                                            class="form-select bg-transparent" disabled>
                                        <option value="0">-- Primero seleccione una Zona --</option>
                                    </select>
                                }
                                <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                    <span asp-validation-for="IdDeposito"></span>
                                </div>
                            </div>
                        </div>
                        <!--end::Selector de Depósito-->
                    </div>
                    <!--end::Fila 2-->
                    <!--begin::Fila 3 — Nombre Departamento y Responsable-->
                    <div class="row">
                        <!--begin::Nombre del Departamento-->
                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="NombreDepto" class="col-form-label text-gray-600 required">Nombre del Departamento</label>
                                <input asp-for="NombreDepto"
                                       id="inputNombreDepto"
                                       class="form-control bg-transparent"
                                       placeholder="Nombre del Departamento"
                                       maxlength="70" />
                                <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                    <span asp-validation-for="NombreDepto"></span>
                                </div>
                            </div>
                        </div>
                        <!--end::Nombre del Departamento-->
                        <!--begin::Responsable-->
                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="Responsable" class="col-form-label text-gray-600 required">Responsable</label>
                                <input asp-for="Responsable"
                                       id="inputResponsable"
                                       class="form-control bg-transparent"
                                       placeholder="Nombre del Responsable"
                                       maxlength="70" />
                                <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                    <span asp-validation-for="Responsable"></span>
                                </div>
                            </div>
                        </div>
                        <!--end::Responsable-->
                    </div>
                    <!--end::Fila 3-->
                    <!--begin::Fila 4 — Estatus-->
                    <div class="row">
                        <div class="col-sm-3 d-flex align-items-end">
                            <div class="form-check mb-8">
                                <input asp-for="ActivoBool" class="form-check-input" id="checkActivoBool" />
                                <label asp-for="ActivoBool" class="form-check-label">Activo</label>
                            </div>
                        </div>
                    </div>
                    <!--end::Fila 4-->
                    <!--begin::Submit-->
                    <div class="mb-10 text-end">
                        <button type="submit" id="kt_depto_in_submit" class="btn btn-primary">
                            <!--begin::Indicator label-->
                            <span class="indicator-label">Guardar</span>
                            <!--end::Indicator label-->
                            <!--begin::Indicator progress-->
                            <span class="indicator-progress">
                                Por favor espere...
                                <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                            </span>
                            <!--end::Indicator progress-->
                        </button>
                    </div>
                    <!--end::Submit-->
                </form>
            </div>
            <!--end::Card body-->
        </div>
        <!--end::Card-->
    </div>
    <!--end::Content container-->
</div>
<!--end::Content-->
@section scripts {
    <script src="~/assets/js/widgets.bundle.js"></script>
    <script src="~/assets/js/custom/widgets.js"></script>
    <script src="~/js/configuracion/departamentos/add.js" asp-append-version="true"></script>
}
}
