@using SUVAN.BackOffice.Models.Facturacion
@using SUVAN.BackOffice.Models.ViewModel;
@using SUVAN.BackOffice.Models.ViewModel.Enums;
@using SUVAN.BackOffice.Portal.Helper;
@inject IUsuarioHelper UsuarioHelper
@{
    ViewData["Title"] = "Depósito";
}

@model DepositoViewModel
@{
    var permisosPagina = await UsuarioHelper.GetPermisosPagina(User, EnumOpcionMenu.empresas);
    if (permisosPagina == null)
    {
        return;
    }
    var isAgregarText = Model.IdDeposito == 0 ? "Agregar" : "Editar";
}
<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar ">
    <!--begin::Toolbar container-->
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
        <!--begin::Toolbar wrapper-->
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <!--begin::Page title-->
            <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                <!--begin::Title-->
                <a href="~/configuracion/depositos" class="page-heading d-flex justify-content-center align-center text-dark fw-bold fs-3 m-0 "><!--flecha regrear-->
                    <i class="ki-duotone ki-left fs-1 pe-5">
                    </i>
                    <span>@isAgregarText @ViewData["Title"]</span>
                </a>
                <!--end::Title-->

            </div>
            <!--end::Page title-->

        </div>
        <!--end::Toolbar wrapper-->
    </div>
    <!--end::Toolbar container-->
</div>
<!--end::Toolbar-->
<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <!--begin::Content container-->
    <div id="kt_app_content_container" class="app-container container-fluid">
        <!--begin::Card-->
        <div class="card">

            <!--begin::Card body-->
            <div class="card-body py-4">


                <form class="form w-100" novalidate="novalidate" id="kt_deposito_in_form" data-kt-redirect-url="configuracion/depositos" asp-controller="Configuracion" asp-action="AgregarDeposito" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="IdEmpresa" type="hidden" value="@User.GetEmpresaId()" />
                    <!-- <input asp-for="id_region" type="hidden" /> -->
                    <input asp-for="IdDeposito" type="hidden" />
                    <!--<input asp-for="id_planta" type="hidden" /> -->
                    <!--<input asp-for="id_zona" type="hidden" /> -->

                    <div class="fv-row mb-8">
                        <div class="col-sm-12">
                            <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                <div asp-validation-summary="All"></div>
                            </div>
                        </div>
                    </div>



                    @* Se agregan los hidden para no perder los datos en el POST al editar *@
                    @if (Model.IdDeposito>0)
                    {
                        <input type="hidden" asp-for="IdRegion" />
                        <input type="hidden" asp-for="IdPlanta" />
                        <input type="hidden" asp-for="IdZona" />
                    }
                    <div class="row">
                        <div class="col-sm-4">
                            <div class="fv-row mb-8">
                                <label asp-for="IdRegion" class="col-form-label text-gray-600 required">Elige la región</label>
                                <select asp-for="IdRegion" asp-items="@(new SelectList(Model.ListadoRegiones, "Id", "Nombre", Model.IdRegion))" class="form-control" disabled="@(Model.IdDeposito > 0)"> <!--disabled="@(Model.IdDeposito > 0)" bloquea select box al editar-->
                                    <option value="0">Seleccione una región... </option>
                                </select>
                                <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                    <span asp-validation-for="IdRegion"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="fv-row mb-8">
                                <label asp-for="IdPlanta" class="col-form-label text-gray-600 required">Elige la planta</label>
                                <select asp-for="IdPlanta" asp-items="@(new SelectList(Model.ListadoPlantas, "Id", "Nombre", Model.IdPlanta))" class="form-control" disabled="@(Model.IdDeposito > 0)"> <!--nameof(RegionModel.Id), nameof(RegionModel.Nombre), Model.id_region))"-->
                                    <option value="0">Seleccione una planta... </option>
                                </select>
                                <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                    <span asp-validation-for="IdPlanta"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="fv-row mb-8">
                                <label asp-for="IdZona" class="col-form-label text-gray-600 required">Elige la zona</label>
                                <select asp-for="IdZona" asp-items="@(new SelectList(Model.ListadoZonas, "Id", "Nombre", Model.IdZona))" class="form-control" disabled="@(Model.IdDeposito > 0)"> <!--nameof(RegionModel.Id), nameof(RegionModel.Nombre), Model.id_region))"-->
                                    <option value="0">Seleccione una zona... </option>
                                </select>
                                <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                    <span asp-validation-for="IdZona"></span>
                                </div>
                            </div>
                        </div>
                    </div> 



                    <div class="row">
                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="NombreDeposito" class="col-sm-12 col-form-label text-gray-600 required">Nombre</label>
                                <div class="col-sm-12">
                                    <input asp-for="NombreDeposito" class="form-control bg-transparent" placeholder="Nombre" maxlength="250" />
                                    <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                        <span asp-validation-for="NombreDeposito"></span>
                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="Direc" class="col-sm-12 col-form-label text-gray-600 required">Dirección</label>
                                <div class="col-sm-12">
                                    <input asp-for="Direc" class="form-control bg-transparent" placeholder="Dirección" />
                                    <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                        <span asp-validation-for="Direc"></span>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="row">
                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="Ciudad" class="col-sm-12 col-form-label text-gray-600 required">Ciudad</label>
                                <div class="col-sm-12">
                                    <input asp-for="Ciudad" class="form-control bg-transparent" placeholder="Ciudad" />
                                    <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                        <span asp-validation-for="Ciudad"></span>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="Respon" class="col-sm-12 col-form-label text-gray-600 required">Respon</label>
                                <div class="col-sm-12">
                                    <input asp-for="Respon" class="form-control bg-transparent" placeholder="Respon" />
                                    <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                        <span asp-validation-for="Respon"></span>
                                    </div>

                                </div>
                            </div>
                        </div>
                        
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="Tel" class="col-sm-12 col-form-label text-gray-600 required">Teléfono</label>
                                <div class="col-sm-12">
                                    <input asp-for="Tel" class="form-control bg-transparent" placeholder="Teléfono" />
                                    <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                        <span asp-validation-for="Tel"></span>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            @* <label asp-for="LocFor">Tipo de Loc For</label>
                            <select asp-for="LocFor" class="form-control">
                                <option value="">-- Seleccione --</option>
                                <option value="L">Local</option>
                                <option value="F">Foráneo</option>
                            </select>
                            <span asp-validation-for="LocFor" class="text-danger"></span> *@
                            <div class="fv-row mb-8">
                                <label asp-for="LocFor" class="col-sm-12 col-form-label text-gray-600 required">Loc For</label>
                                <div class="col-sm-12">
                                    <input asp-for="LocFor" class="form-control bg-transparent" placeholder="Loc For" />
                                    <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                        <span asp-validation-for="LocFor"></span>
                                    </div>

                                </div>
                            </div>
                        </div>
                        
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="RPerson" class="col-sm-12 col-form-label text-gray-600 required">r person</label>
                                <div class="col-sm-12">
                                    <input asp-for="RPerson" class="form-control bg-transparent" placeholder="r person" />
                                    <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                        <span asp-validation-for="RPerson"></span>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="NomCorto" class="col-sm-12 col-form-label text-gray-600 required">Nombre Corto</label>
                                <div class="col-sm-12">
                                    <input asp-for="NomCorto" class="form-control bg-transparent" placeholder="Nombre Corto" />
                                    <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                        <span asp-validation-for="NomCorto"></span>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="Cp" class="col-sm-12 col-form-label text-gray-600 required">Código Postal</label>
                                <div class="col-sm-12">
                                    <input asp-for="Cp" class="form-control bg-transparent" placeholder="Código Postal" />
                                    <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                        <span asp-validation-for="Cp"></span>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="fv-row mb-8">
                                <label asp-for="Rfc" class="col-sm-12 col-form-label text-gray-600 required">RFC</label>
                                <div class="col-sm-12">
                                    <input asp-for="Rfc" class="form-control bg-transparent" placeholder="RFC" />
                                    <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback">
                                        <span asp-validation-for="Rfc"></span>
                                    </div>

                                </div>
                            </div>
                        </div>
                                
                    </div>

                    <div class="mb-10 text-end">

                        <button type="submit" id="kt_deposito_in_submit" class="btn btn-primary">
                            <!--begin::Indicator label-->
                            <span class="indicator-label">Guardar</span>
                            <!--end::Indicator label-->
                            <!--begin::Indicator progress-->
                            <span class="indicator-progress">
                                Por favor espere...
                                <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                            </span>
                            <!--end::Indicator progress-->
                        </button>
                    </div>
                </form>


            </div>
            <!--end::Card body-->
        </div>
        <!--end::Card-->
    </div>
    <!--end::Content container-->
</div>
<!--end::Content-->
@section scripts {
    <script src="~/js/configuracion/depositos/add.js" asp-append-version="true"></script>
    <script src="~/assets/js/widgets.bundle.js"></script>
    <script src="~/assets/js/custom/widgets.js"></script>

}